---
import "../styles/global.css";
import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
  env: Astro.locals.runtime.env,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/login");
}

const { data: profile } = await supabase
  .from("profiles")
  .select("username, full_name, bio, avatar_url, created_at")
  .eq("id", user.id)
  .single();

const displayName =
  profile?.full_name ||
  user.user_metadata?.full_name ||
  user.email?.split("@")[0] ||
  "Member";

const username =
  profile?.username ||
  user.user_metadata?.username ||
  "member";

const email = user.email || "";

const bio =
  profile?.bio ||
  "Your Melagram identity starts here. Tell the community a little about yourself.";

const avatarUrl = profile?.avatar_url || "";

const initials = displayName
  .split(" ")
  .map((part: string) => part.charAt(0))
  .join("")
  .slice(0, 2)
  .toUpperCase();

const memberSince = profile?.created_at
  ? new Date(profile.created_at).toLocaleDateString("en-US", {
      month: "long",
      year: "numeric",
    })
  : "2026";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Melagram profile for ${displayName}`}
    />
    <title>{displayName} — Melagram</title>
  </head>

  <body>
    <main
      class="min-h-screen overflow-hidden bg-[#050208] text-[#fff7e5]"
    >

      <!-- LUXURY PAGE BACKGROUND -->
      <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(109,25,201,.35),transparent_38rem)]"
        ></div>

        <div
          class="absolute -left-40 top-80 h-[500px] w-[500px] rounded-full bg-[#6d19c9]/15 blur-[120px]"
        ></div>

        <div
          class="absolute -right-40 top-[40rem] h-[600px] w-[600px] rounded-full bg-[#8b22d9]/15 blur-[140px]"
        ></div>

        <div
          class="absolute left-1/2 top-[75rem] h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-[#d9ad55]/5 blur-[120px]"
        ></div>
      </div>


      <!-- TOP GOLD LINE -->
      <div class="h-1 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>


      <!-- NAV -->
      <nav class="border-b border-[#d9ad55]/20 bg-[#07030d]/80 backdrop-blur-xl">
        <div
          class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8"
        >

          <a href="/dashboard" class="flex items-center gap-3">
            <div
              class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#1a0827] text-[#ffe8a6] shadow-[0_0_22px_rgba(109,25,201,.35)]"
            >
              M
            </div>

            <div class="hidden sm:block">
              <div
                class="display text-sm font-bold tracking-[.2em] text-[#ffe8a6]"
              >
                MELAGRAM
              </div>

              <div
                class="text-[8px] uppercase tracking-[.25em] text-white/35"
              >
                Connect. Create. Build.
              </div>
            </div>
          </a>


          <div
            class="hidden items-center gap-7 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60 lg:flex"
          >
            <a class="nav-link hover:text-[#ffe8a6]" href="/dashboard">
              Home
            </a>

            <a class="nav-link hover:text-[#ffe8a6]" href="/discover">
              Discover
            </a>

            <a class="nav-link hover:text-[#ffe8a6]" href="/communities">
              Communities
            </a>

            <a class="nav-link hover:text-[#ffe8a6]" href="/creators">
              Creators
            </a>
          </div>


          <a
            href="/dashboard"
            class="rounded-full border border-[#d9ad55]/50 px-4 py-2 text-[9px] font-bold uppercase tracking-[.18em] text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
          >
            Dashboard
          </a>

        </div>
      </nav>


      <!-- PROFILE AREA -->
      <section class="relative px-5 py-12 sm:px-8 lg:py-16">

        <div
          class="absolute left-1/2 top-0 h-[450px] w-[700px] -translate-x-1/2 rounded-full bg-[#6d19c9]/20 blur-[120px]"
        ></div>

        <div class="relative mx-auto max-w-6xl">

          <!-- PROFILE CARD -->
          <div
            class="luxury-panel gold-border overflow-hidden rounded-[2rem] shadow-[0_30px_100px_rgba(0,0,0,.55)]"
          >

            <!-- PROFILE IDENTITY -->
            <div class="relative px-6 py-8 sm:px-10 sm:py-10">

              <!-- Decorative glow -->
              <div
                class="pointer-events-none absolute right-0 top-0 h-56 w-80 bg-[radial-gradient(circle_at_80%_20%,rgba(135,44,225,.45),transparent_65%)]"
              ></div>

              <div
                class="relative flex flex-col gap-7 sm:flex-row sm:items-center"
              >

                <!-- PROFILE IMAGE -->
                <div class="shrink-0">

                  {
                    avatarUrl ? (
                      <img
                        src={avatarUrl}
                        alt={`${displayName} profile photo`}
                        class="h-28 w-28 rounded-full border-2 border-[#d9ad55]/90 object-cover shadow-[0_0_35px_rgba(109,25,201,.45)] sm:h-32 sm:w-32"
                      />
                    ) : (
                      <div
                        class="grid h-28 w-28 place-items-center rounded-full border-2 border-[#d9ad55]/90 bg-[#09040f] text-3xl font-semibold text-[#ffe8a6] shadow-[0_0_35px_rgba(109,25,201,.45)] sm:h-32 sm:w-32 sm:text-4xl"
                      >
                        {initials}
                      </div>
                    )
                  }

                </div>


                <!-- NAME / USERNAME -->
                <div class="min-w-0 flex-1">

                  <p
                    class="text-[9px] font-bold uppercase tracking-[.35em] text-[#d9ad55]"
                  >
                    Melagram Member
                  </p>

                  <h1
                    class="display mt-2 break-words text-3xl text-[#ffe8a6] sm:text-4xl lg:text-5xl"
                  >
                    {displayName}
                  </h1>

                  <p class="mt-2 text-base text-white/45">
                    @{username}
                  </p>

                </div>


                <!-- EDIT BUTTON -->
                <div class="shrink-0 sm:self-center">

                  <a
                    href="/edit-profile"
                    class="inline-flex items-center justify-center rounded-full border border-[#d9ad55]/70 px-5 py-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#ffe8a6] transition hover:bg-[#d9ad55]/10 hover:shadow-[0_0_25px_rgba(217,173,85,.12)]"
                  >
                    Edit Profile
                  </a>

                </div>

              </div>


              <!-- GOLD DIVIDER -->
              <div class="gold-line my-8"></div>


              <!-- STATS -->
              <div class="grid grid-cols-3 text-center">

                <div class="border-r border-white/10">
                  <p class="display text-2xl text-[#ffe8a6]">
                    0
                  </p>

                  <p
                    class="mt-2 text-[9px] font-semibold uppercase tracking-[.2em] text-white/40"
                  >
                    Posts
                  </p>
                </div>


                <div class="border-r border-white/10">
                  <p class="display text-2xl text-[#ffe8a6]">
                    0
                  </p>

                  <p
                    class="mt-2 text-[9px] font-semibold uppercase tracking-[.2em] text-white/40"
                  >
                    Followers
                  </p>
                </div>


                <div>
                  <p class="display text-2xl text-[#ffe8a6]">
                    0
                  </p>

                  <p
                    class="mt-2 text-[9px] font-semibold uppercase tracking-[.2em] text-white/40"
                  >
                    Following
                  </p>
                </div>

              </div>

            </div>

          </div>


          <!-- PROFILE TABS -->
          <div
            class="gold-border luxury-panel mt-7 overflow-hidden rounded-2xl"
          >

            <div
              class="grid grid-cols-4 overflow-x-auto sm:grid-cols-7"
            >

              <a
                href="#about"
                class="border-b-2 border-[#d9ad55] px-4 py-4 text-center text-[9px] font-bold uppercase tracking-[.15em] text-[#ffe8a6]"
              >
                About
              </a>

              <a
                href="#"
                class="px-4 py-4 text-center text-[9px] font-semibold uppercase tracking-[.15em] text-white/40 transition hover:text-[#ffe8a6]"
              >
                Posts
              </a>

              <a
                href="#"
                class="px-4 py-4 text-center text-[9px] font-semibold uppercase tracking-[.15em] text-white/40 transition hover:text-[#ffe8a6]"
              >
                Media
              </a>

              <a
                href="#"
                class="hidden px-4 py-4 text-center text-[9px] font-semibold uppercase tracking-[.15em] text-white/40 transition hover:text-[#ffe8a6] sm:block"
              >
                Events
              </a>

              <a
                href="#"
                class="hidden px-4 py-4 text-center text-[9px] font-semibold uppercase tracking-[.15em] text-white/40 transition hover:text-[#ffe8a6] sm:block"
              >
                Groups
              </a>

              <a
                href="#"
                class="hidden px-4 py-4 text-center text-[9px] font-semibold uppercase tracking-[.15em] text-white/40 transition hover:text-[#ffe8a6] sm:block"
              >
                Activity
              </a>

              <a
                href="#"
                class="hidden px-4 py-4 text-center text-[9px] font-semibold uppercase tracking-[.15em] text-white/40 transition hover:text-[#ffe8a6] sm:block"
              >
                Saved
              </a>

            </div>

          </div>


          <!-- ABOUT -->
          <div
            id="about"
            class="gold-border luxury-panel mt-7 rounded-2xl p-7 shadow-[0_25px_70px_rgba(0,0,0,.35)] sm:p-10"
          >

            <p
              class="text-[9px] font-bold uppercase tracking-[.4em] text-[#d9ad55]"
            >
              About Me
            </p>

            <h2 class="display mt-3 text-3xl text-[#ffe8a6] sm:text-4xl">
              My Melagram
            </h2>


            <div class="my-6 flex items-center gap-4">

              <div class="gold-line flex-1"></div>

              <span class="text-lg text-[#ffe8a6]">
                ✦
              </span>

              <div class="gold-line flex-1"></div>

            </div>


            <p class="max-w-3xl text-sm leading-8 text-white/60">
              {bio}
            </p>


            <div class="mt-8 grid gap-6 sm:grid-cols-2">

              <div>
                <p
                  class="text-[9px] font-bold uppercase tracking-[.25em] text-[#d9ad55]"
                >
                  Name
                </p>

                <p class="mt-2 text-sm text-white/75">
                  {displayName}
                </p>
              </div>


              <div>
                <p
                  class="text-[9px] font-bold uppercase tracking-[.25em] text-[#d9ad55]"
                >
                  Username
                </p>

                <p class="mt-2 text-sm text-white/75">
                  @{username}
                </p>
              </div>


              <div>
                <p
                  class="text-[9px] font-bold uppercase tracking-[.25em] text-[#d9ad55]"
                >
                  Email
                </p>

                <p class="mt-2 break-all text-sm text-white/75">
                  {email}
                </p>
              </div>


              <div>
                <p
                  class="text-[9px] font-bold uppercase tracking-[.25em] text-[#d9ad55]"
                >
                  Member Since
                </p>

                <p class="mt-2 text-sm text-white/75">
                  {memberSince}
                </p>
              </div>

            </div>


            <div class="mt-9">

              <a
                href="/edit-profile"
                class="inline-flex rounded-full border border-[#d9ad55]/60 px-5 py-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
              >
                Update Profile
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- FOOTER -->
      <footer
        class="relative mt-10 border-t border-[#d9ad55]/15 bg-[#07030d]/80 px-5 py-14 sm:px-8"
      >

        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(109,25,201,.28),transparent_45rem)]"
        ></div>

        <div class="relative mx-auto max-w-5xl text-center">

          <div
            class="display text-6xl leading-none text-[#ffe8a6] drop-shadow-[0_0_25px_rgba(217,173,85,.25)]"
          >
            M
          </div>

          <div
            class="display mt-3 text-2xl tracking-[.15em] text-[#ffe8a6]"
          >
            MELAGRAM
          </div>

          <p
            class="mt-2 text-[9px] uppercase tracking-[.25em] text-white/35"
          >
            Connect. Create. Build Community.
          </p>


          <div
            class="mt-8 flex flex-wrap justify-center gap-x-7 gap-y-3 text-[9px] font-semibold uppercase tracking-[.15em] text-white/45"
          >
            <a href="/about" class="hover:text-[#ffe8a6]">About</a>
            <a href="#" class="hover:text-[#ffe8a6]">Terms</a>
            <a href="#" class="hover:text-[#ffe8a6]">Privacy</a>
            <a href="#" class="hover:text-[#ffe8a6]">Support</a>
            <a href="#" class="hover:text-[#ffe8a6]">Contact</a>
          </div>


          <p class="mt-10 text-[10px] text-white/25">
            © 2026 Melagram. All rights reserved.
          </p>

        </div>

      </footer>


      <!-- BOTTOM GOLD LINE -->
      <div class="h-1 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>

    </main>
  </body>
</html>