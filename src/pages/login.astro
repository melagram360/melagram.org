---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In | Melagram</title>
    <meta
      name="description"
      content="Log in to your Melagram account and reconnect with your communities."
    />
  </head>

  <body>
    <div class="min-h-screen overflow-hidden bg-[#050208] text-[#fff7e5]">

      <!-- NAV -->
      <header class="relative z-20 border-b border-[#d9ad55]/30 bg-[#07030d]/90 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">

          <a href="/" class="flex items-center gap-3" aria-label="Melagram Home">
            <div class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#1a0827] text-[#ffe8a6] shadow-[0_0_18px_rgba(109,25,201,.4)]">
              M
            </div>

            <div>
              <div class="font-serif text-sm font-bold tracking-[.2em] text-[#ffe8a6]">
                MELAGRAM
              </div>

              <div class="text-[8px] uppercase tracking-[.25em] text-white/35">
                Connect. Create. Build.
              </div>
            </div>
          </a>

          <a
            href="/"
            class="text-[10px] font-bold uppercase tracking-[.2em] text-white/50 transition hover:text-[#ffe8a6]"
          >
            ← Back Home
          </a>

        </nav>
      </header>


      <!-- LOGIN -->
      <main class="relative flex min-h-[calc(100vh-81px)] items-center justify-center px-5 py-14 sm:py-20">

        <!-- Ambient Glow -->
        <div class="pointer-events-none absolute left-1/2 top-0 h-[620px] w-[620px] -translate-x-1/2 rounded-full bg-[#6d19c9]/15 blur-3xl"></div>

        <div class="pointer-events-none absolute left-1/2 top-16 h-[430px] w-[430px] -translate-x-1/2 rounded-full border border-[#d9ad55]/10"></div>

        <div class="pointer-events-none absolute left-1/2 top-28 h-[350px] w-[350px] -translate-x-1/2 rounded-full border border-[#d9ad55]/10"></div>


        <div class="relative z-10 w-full max-w-md">

          <!-- LOGIN CARD -->
          <section class="luxury-panel gold-border rounded-3xl p-6 shadow-[0_25px_80px_rgba(0,0,0,.5)] sm:p-9">

            <!-- Heading -->
            <div class="mb-8 text-center">

              <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-full border-2 border-[#d9ad55]/70 bg-[#160722] text-2xl text-[#ffe8a6] shadow-[0_0_30px_rgba(109,25,201,.35)]">
                M
              </div>

              <p class="text-[9px] font-bold uppercase tracking-[.3em] text-[#d9ad55]">
                Welcome Back
              </p>

              <h1 class="mt-3 text-3xl font-semibold text-[#fff7e5]">
                Log In to Melagram
              </h1>

              <p class="mt-3 text-sm leading-6 text-white/40">
                Your communities are waiting for you.
              </p>

            </div>


            <!-- FORM -->
            <form class="space-y-5">

              <!-- EMAIL -->
              <div>

                <label
                  for="email"
                  class="mb-2 block text-[9px] font-bold uppercase tracking-[.2em] text-white/55"
                >
                  Email Address
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="you@example.com"
                  autocomplete="email"
                  required
                  class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3.5 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#d9ad55]/70 focus:bg-black/40"
                />

              </div>


              <!-- PASSWORD -->
              <div>

                <div class="mb-2 flex items-center justify-between gap-3">

                  <label
                    for="password"
                    class="text-[9px] font-bold uppercase tracking-[.2em] text-white/55"
                  >
                    Password
                  </label>

                  <a
                    href="/forgot-password"
                    class="text-[9px] font-semibold uppercase tracking-[.15em] text-[#d9ad55] transition hover:text-[#ffe8a6]"
                  >
                    Forgot Password?
                  </a>

                </div>

                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                  class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3.5 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#d9ad55]/70 focus:bg-black/40"
                />

              </div>


              <!-- REMEMBER -->
              <label class="flex items-center gap-3 pt-1">

                <input
                  type="checkbox"
                  name="remember"
                  class="h-4 w-4 rounded border-white/20 bg-black/30 accent-[#6d19c9]"
                />

                <span class="text-[11px] text-white/40">
                  Keep me signed in
                </span>

              </label>


              <!-- LOGIN BUTTON -->
              <button
                type="submit"
                class="cta w-full rounded-xl px-6 py-4 text-xs font-bold uppercase tracking-[.2em] text-white"
              >
                Log In
              </button>

            </form>


            <!-- DIVIDER -->
            <div class="my-7 flex items-center gap-4">

              <div class="h-px flex-1 bg-white/10"></div>

              <span class="text-[9px] uppercase tracking-[.2em] text-white/25">
                New to Melagram?
              </span>

              <div class="h-px flex-1 bg-white/10"></div>

            </div>


            <!-- CREATE ACCOUNT -->
            <a
              href="/join"
              class="block w-full rounded-xl border border-[#d9ad55]/35 bg-black/20 px-6 py-3.5 text-center text-xs font-bold uppercase tracking-[.2em] text-[#ffe8a6] transition hover:border-[#d9ad55]/70 hover:bg-[#d9ad55]/5"
            >
              Create an Account
            </a>


            <!-- SMALL FOOTER -->
            <p class="mt-7 text-center text-[10px] leading-5 text-white/25">
              By continuing, you agree to Melagram's
              <a href="#" class="text-white/40 hover:text-[#ffe8a6]">
                Terms
              </a>
              and
              <a href="#" class="text-white/40 hover:text-[#ffe8a6]">
                Privacy Policy
              </a>.
            </p>

          </section>

        </div>

      </main>


      <!-- FOOTER -->
      <footer class="border-t border-[#d9ad55]/20 bg-[#07030d] px-5 py-8">

        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">

          <p class="text-[9px] uppercase tracking-[.25em] text-white/25">
            © 2026 Melagram. Connect. Network. Create. Build Community.
          </p>

          <a
            href="/"
            class="text-[9px] font-bold uppercase tracking-[.2em] text-[#d9ad55] hover:text-[#ffe8a6]"
          >
            Melagram
          </a>

        </div>

      </footer>

    </div>
  </body>
</html>