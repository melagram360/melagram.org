---
import "../styles/global.css";
import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

const { data: communities, error: communitiesError } = await supabase
  .from("communities")
  .select("id, slug, name, category, description, icon, created_at")
  .order("created_at", { ascending: true });

const communityList = communities ?? [];

const communitiesWithCounts = await Promise.all(
  communityList.map(async (community) => {
    const { count, error } = await supabase
      .from("community_members")
      .select("*", { count: "exact", head: true })
      .eq("community_id", community.id);

    return { ...community, memberCount: error ? 0 : count ?? 0 };
  })
);

const categories = [
  "All Communities",
  ...Array.from(
    new Set(
      communityList.map((community) => community.category).filter(Boolean)
    )
  ),
];

const formatMemberCount = (count: number) =>
  count === 1 ? "1 member" : `${count.toLocaleString()} members`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore communities and find your people on Melagram." />
    <title>Communities — Melagram</title>
  </head>

  <body>
    <div class="min-h-screen overflow-hidden">
      <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>

      <header class="relative z-20 border-b border-[#d9ad55]/30 bg-[#07030d]/90 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">
          <a href="/" class="flex items-center gap-3" aria-label="Melagram Home">
            <div class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#1a0827] text-[#ffe8a6] shadow-[0_0_18px_rgba(109,25,201,.4)]">
              M
            </div>
            <span class="display hidden text-lg tracking-[.18em] text-[#ffe8a6] sm:block">MELAGRAM</span>
          </a>

          <div class="hidden items-center gap-7 text-[11px] font-semibold uppercase tracking-[.22em] text-white/75 md:flex">
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/discover">Discover</a>
            <a class="nav-link text-[#d9ad55]" href="/communities">Communities</a>
            <a class="nav-link" href="/gossip">Gossip</a>
            <a class="nav-link" href="/creators">Creators</a>
            <a class="nav-link" href="/search">Search</a>
          </div>

          <div class="flex items-center gap-3">
            {user ? (
              <>
                <a href="/dashboard" class="hidden rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white/80 transition hover:text-[#ffe8a6] sm:block">Dashboard</a>
                <a href="/profile" class="cta rounded-full px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white">Profile</a>
              </>
            ) : (
              <>
                <a href="/login" class="hidden rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white/80 transition hover:text-[#ffe8a6] sm:block">Log In</a>
                <a href="/join" class="cta rounded-full px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white">Join Melagram</a>
              </>
            )}
          </div>
        </nav>
      </header>

      <main>
        <section class="relative px-5 pb-14 pt-16 sm:pt-20 lg:px-10">
          <div class="absolute inset-x-0 top-0 h-96 bg-[radial-gradient(circle_at_center,rgba(109,25,201,.27),transparent_65%)]"></div>

          <div class="relative mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-center gap-4">
              <div class="gold-line w-20 sm:w-40"></div>
              <span class="text-[9px] font-semibold uppercase tracking-[.45em] text-[#d9ad55]">Find Your Community</span>
              <div class="gold-line w-20 sm:w-40"></div>
            </div>

            <div class="mx-auto max-w-4xl text-center">
              <p class="text-[10px] font-bold uppercase tracking-[.5em] text-[#d9ad55]">COMMUNITIES</p>
              <h1 class="display mt-4 text-5xl leading-tight text-[#fff4d4] sm:text-7xl">Find your people.</h1>
              <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-white/55 sm:text-lg">
                Join conversations, meet like-minded people, and find communities built around the things you care about.
              </p>
            </div>

            <div class="mx-auto mt-10 max-w-2xl">
              <div class="luxury-panel gold-border rounded-2xl p-2">
                <div class="flex items-center gap-3 rounded-xl bg-black/30 px-4 py-3">
                  <span class="text-xl text-[#d9ad55]">⌕</span>
                  <input id="community-search" type="search" placeholder="Search communities..." class="w-full bg-transparent text-sm text-white outline-none placeholder:text-white/30" />
                  <button type="button" class="cta rounded-lg px-5 py-3 text-xs font-bold uppercase tracking-wider text-white">Search</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="border-y border-[#d9ad55]/20 bg-[#08030f]/80 px-5 py-4 lg:px-10">
          <div class="mx-auto max-w-7xl">
            <div class="relative flex items-center justify-between gap-4">

              <div class="flex min-w-0 items-center gap-3">
                <span class="text-[9px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">
                  Communities
                </span>
                <div class="hidden h-px flex-1 bg-gradient-to-r from-[#d9ad55]/60 to-transparent sm:block"></div>
              </div>

              <button
                id="category-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="community-filters-panel"
                class="shrink-0 rounded-full border border-[#d9ad55]/50 bg-black/25 px-4 py-2 text-[9px] font-bold uppercase tracking-[.14em] text-[#ffe8a6] transition hover:border-[#d9ad55] hover:bg-[#d9ad55]/10"
              >
                Categories
                <span id="category-toggle-icon" class="ml-1">▾</span>
              </button>

              <div
                id="community-filters-panel"
                class="absolute right-0 top-full z-30 mt-3 hidden w-full max-w-3xl rounded-2xl border border-[#d9ad55]/35 bg-[#10061a]/98 p-4 shadow-[0_18px_50px_rgba(0,0,0,.55)] backdrop-blur-xl sm:w-auto sm:min-w-[520px]"
              >
                <div class="mb-3 flex items-center justify-between gap-3">
                  <p class="text-[9px] font-bold uppercase tracking-[.3em] text-white/35">
                    Filter Communities
                  </p>
                  <button
                    id="category-close"
                    type="button"
                    class="text-xs text-white/35 transition hover:text-[#ffe8a6]"
                    aria-label="Close categories"
                  >
                    ✕
                  </button>
                </div>

                <div class="flex flex-wrap gap-2" id="community-filters">
                  {categories.map((category, index) => (
                    <button
                      type="button"
                      data-category={category}
                      aria-pressed={index === 0 ? "true" : "false"}
                      class:list={[
                        "community-filter whitespace-nowrap rounded-full border px-4 py-2 text-[9px] font-bold uppercase tracking-[.12em] transition",
                        index === 0
                          ? "border-[#d9ad55] bg-[#d9ad55] text-black"
                          : "border-[#d9ad55]/25 bg-black/20 text-white/55 hover:border-[#d9ad55]/70 hover:text-[#ffe8a6]"
                      ]}
                    >
                      {category === "All Communities" ? "All" : category}
                    </button>
                  ))}
                </div>
              </div>

            </div>
          </div>
        </section>

        <section class="px-5 py-16 lg:px-10">
          <div class="mx-auto max-w-7xl">
            <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[.45em] text-[#d9ad55]">Explore</p>
                <h2 class="display mt-3 text-4xl text-[#fff4d4] sm:text-5xl">Featured Communities</h2>
              </div>
              <p class="max-w-md text-sm leading-6 text-white/40 sm:text-right">Discover spaces where conversations are happening and connections are being made.</p>
            </div>

            {communitiesError ? (
              <div class="luxury-panel gold-border rounded-2xl p-10 text-center">
                <p class="text-sm text-white/55">We couldn't load the communities right now. Please refresh and try again.</p>
              </div>
            ) : communityList.length === 0 ? (
              <div class="luxury-panel gold-border rounded-2xl p-10 text-center">
                <p class="text-sm text-white/55">No communities are available yet.</p>
              </div>
            ) : (
              <>
                <div id="community-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                  {communitiesWithCounts.map((community) => (
                    <a
                      href={`/communities/${community.slug}`}
                      class="feature-card luxury-panel gold-border block rounded-2xl p-7"
                      data-community-card
                      data-community-category={community.category}
                      data-community-search={`${community.name} ${community.category} ${community.description}`.toLowerCase()}
                    >
                      <div class="flex items-start justify-between gap-4">
                        <div class="grid h-14 w-14 shrink-0 place-items-center rounded-full border border-[#d9ad55]/60 bg-[#160722] text-2xl">{community.icon}</div>
                        <span class="rounded-full border border-[#d9ad55]/25 px-3 py-1 text-[9px] font-semibold uppercase tracking-wider text-[#d9ad55]">{community.category}</span>
                      </div>

                      <h3 class="display mt-6 text-2xl text-[#ffe8a6]">{community.name}</h3>
                      <p class="mt-3 text-sm leading-7 text-white/50">{community.description}</p>

                      <div class="mt-6 flex items-center justify-between border-t border-[#d9ad55]/15 pt-5">
                        <span class="text-[10px] uppercase tracking-wider text-white/35">{formatMemberCount(community.memberCount)}</span>
                        <span class="rounded-lg border border-[#d9ad55]/60 px-4 py-2 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#d9ad55] hover:text-black">View Community</span>
                      </div>
                    </a>
                  ))}
                </div>

                <div id="community-empty-state" class="luxury-panel gold-border mt-6 hidden rounded-2xl p-10 text-center">
                  <p class="text-sm text-white/55">No communities match your search or filter.</p>
                </div>
              </>
            )}
          </div>
        </section>
      </main>

      <footer class="border-t border-[#d9ad55]/20 bg-[#050208] px-5 py-10 lg:px-10">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 text-center sm:flex-row sm:text-left">
          <div>
            <p class="display text-lg tracking-[.2em] text-[#ffe8a6]">MELAGRAM</p>
            <p class="mt-1 text-[10px] uppercase tracking-[.3em] text-white/35">Connect. Network. Create. Build Community.</p>
          </div>
          <p class="text-xs text-white/30">© 2026 Melagram. All rights reserved.</p>
        </div>
      </footer>

      <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>
    </div>

    <script>
      const searchInput = document.querySelector("#community-search") as HTMLInputElement | null;
      const categoryToggle = document.querySelector("#category-toggle") as HTMLButtonElement | null;
      const categoryPanel = document.querySelector("#community-filters-panel") as HTMLElement | null;
      const categoryClose = document.querySelector("#category-close") as HTMLButtonElement | null;
      const categoryToggleIcon = document.querySelector("#category-toggle-icon") as HTMLElement | null;
      const filterButtons = document.querySelectorAll<HTMLButtonElement>(".community-filter");
      const cards = document.querySelectorAll<HTMLElement>("[data-community-card]");
      const emptyState = document.querySelector("#community-empty-state");
      let activeCategory = "All Communities";

      const updateDirectory = () => {
        const query = searchInput?.value.trim().toLowerCase() || "";
        let visibleCount = 0;

        cards.forEach((card) => {
          const category = card.dataset.communityCategory || "";
          const searchable = card.dataset.communitySearch || "";
          const visible =
            (activeCategory === "All Communities" || category === activeCategory) &&
            (!query || searchable.includes(query));

          card.classList.toggle("hidden", !visible);
          if (visible) visibleCount++;
        });

        emptyState?.classList.toggle("hidden", visibleCount > 0);
      };

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeCategory = button.dataset.category || "All Communities";

          filterButtons.forEach((item) => {
            const active = item === button;
            item.setAttribute("aria-pressed", active ? "true" : "false");
            item.classList.toggle("border-[#d9ad55]", active);
            item.classList.toggle("bg-[#d9ad55]", active);
            item.classList.toggle("text-black", active);
            item.classList.toggle("border-[#d9ad55]/25", !active);
            item.classList.toggle("bg-black/20", !active);
            item.classList.toggle("text-white/55", !active);
          });

          updateDirectory();
        });
      });

      searchInput?.addEventListener("input", updateDirectory);

      const closeCategoryPanel = () => {
        categoryPanel?.classList.add("hidden");
        categoryToggle?.setAttribute("aria-expanded", "false");
        if (categoryToggleIcon) categoryToggleIcon.textContent = "▾";
      };

      categoryToggle?.addEventListener("click", () => {
        const isOpen = !categoryPanel?.classList.contains("hidden");
        categoryPanel?.classList.toggle("hidden", isOpen);
        categoryToggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
        if (categoryToggleIcon) categoryToggleIcon.textContent = isOpen ? "▾" : "▴";
      });

      categoryClose?.addEventListener("click", closeCategoryPanel);

      filterButtons.forEach((button) => {
        button.addEventListener("click", closeCategoryPanel);
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node | null;
        if (
          categoryPanel &&
          categoryToggle &&
          target &&
          !categoryPanel.contains(target) &&
          !categoryToggle.contains(target)
        ) {
          closeCategoryPanel();
        }
      });
    </script>
  </body>
</html>
