---
import "../../styles/global.css";
import { createClient } from "../../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
  env: Astro.locals.runtime.env,
});

const { data: { user: currentUser } } = await supabase.auth.getUser();

const creatorCategories = [
  { icon: "♪", title: "Music", subtitle: "Artists • Producers • DJs", description: "Artists, producers, singers, and sound creators." },
  { icon: "✒", title: "Writing", subtitle: "Authors • Poets • Storytellers", description: "Authors, poets, bloggers, and storytellers." },
  { icon: "◈", title: "Art & Design", subtitle: "Artists • Designers • Visual Creators", description: "Visual artists, designers, illustrators, and creatives." },
  { icon: "▣", title: "Film & Video", subtitle: "Filmmakers • Directors • Video Creators", description: "Filmmakers, directors, editors, and video creators." },
  { icon: "♬", title: "Podcasting", subtitle: "Hosts • Commentators • Broadcasters", description: "Hosts, commentators, and audio content creators." },
  { icon: "▢", title: "Business", subtitle: "Founders • Entrepreneurs • Visionaries", description: "Entrepreneurs, founders, coaches, and visionaries." },
];

const { data: creatorProfiles, error: creatorProfilesError } = await supabase
  .from("profiles")
  .select("id, username, full_name, bio, avatar_url, creator_category, creator_enabled, created_at")
  .eq("creator_enabled", true)
  .not("creator_category", "is", null)
  .order("created_at", { ascending: false });

const creators = creatorProfiles ?? [];
const creatorCounts = new Map<string, number>();
for (const category of creatorCategories) creatorCounts.set(category.title, 0);
for (const creator of creators) {
  if (creator.creator_category) {
    creatorCounts.set(creator.creator_category, (creatorCounts.get(creator.creator_category) ?? 0) + 1);
  }
}

function getInitials(name: string | null | undefined) {
  const value = (name ?? "Melagram Creator").trim();
  return value.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join("").toUpperCase() || "MC";
}

function getDisplayName(creator: any) {
  return creator.full_name?.trim() || creator.username?.trim() || "Melagram Creator";
}

function getCategoryDescription(category: string | null) {
  return creatorCategories.find((item) => item.title === category)?.description || "A Melagram creator sharing their work and creative voice.";
}
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Enter the Creators Vault — discover the artists, storytellers, visionaries, and creators of Melagram." />
  <title>Creators Vault — Melagram</title>
</head>
<body>
  <div class="min-h-screen overflow-hidden bg-[#050208] text-white">
    <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>

    <header class="relative z-30 border-b border-[#d9ad55]/30 bg-[#050208]/95 backdrop-blur">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">
        <a href="/" class="flex items-center gap-3">
          <div class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#160722] text-xl text-[#ffe8a6]">♔</div>
          <span class="display hidden text-lg tracking-[.2em] text-[#ffe8a6] sm:block">MELAGRAM</span>
        </a>
        <div class="hidden items-center gap-7 text-[10px] font-bold uppercase tracking-[.22em] text-white/70 md:flex">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link" href="/discover">Discover</a>
          <a class="nav-link" href="/communities">Communities</a>
          <a class="nav-link" href="/gossip">Gossip</a>
          <a class="nav-link text-[#ffe8a6]" href="/creators">Creators</a>
          <a class="nav-link" href="/about">About</a>
        </div>
        <div class="flex items-center gap-3">
          {currentUser ? (
            <>
              <a href="/dashboard" class="hidden text-[10px] font-bold uppercase tracking-wider text-white/60 transition hover:text-[#ffe8a6] sm:block">Dashboard</a>
              <a href="/profile" class="rounded-lg border border-[#d9ad55]/70 px-4 py-2 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#24102f]">Profile</a>
            </>
          ) : (
            <>
              <a href="/login" class="hidden text-[10px] font-bold uppercase tracking-wider text-white/60 transition hover:text-[#ffe8a6] sm:block">Sign In</a>
              <a href="/join" class="rounded-lg border border-[#d9ad55]/70 bg-[#6d19c9]/20 px-4 py-2 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#6d19c9]/40">Join</a>
            </>
          )}
        </div>
      </nav>
    </header>

    <main>
      <section class="relative overflow-hidden bg-[#050208] px-4 pb-0 sm:px-6 lg:px-10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(109,25,201,.22),transparent_50%)]"></div>
        <div class="relative mx-auto max-w-7xl">
          <div class="relative mx-auto max-w-5xl pt-12 sm:pt-16">
            <div class="absolute inset-x-8 top-10 h-[430px] rounded-t-[260px] border-x-4 border-t-4 border-[#d9ad55]/35 bg-gradient-to-b from-[#24102f]/30 to-transparent sm:inset-x-20 sm:h-[500px]"></div>
            <div class="absolute left-4 top-16 hidden h-[390px] w-12 border-x-4 border-[#d9ad55]/50 bg-gradient-to-b from-[#3b1553] to-[#160722] sm:block"></div>
            <div class="absolute right-4 top-16 hidden h-[390px] w-12 border-x-4 border-[#d9ad55]/50 bg-gradient-to-b from-[#3b1553] to-[#160722] sm:block"></div>
            <div class="relative mx-auto max-w-3xl px-4 pt-14 sm:pt-20">
              <div class="relative overflow-hidden rounded-t-[180px] border-4 border-[#d9ad55]/80 bg-gradient-to-b from-[#fff0c5] via-[#d9ad55] to-[#8c6322] px-6 pb-14 pt-20 text-center shadow-[0_0_60px_rgba(217,173,85,.18)] sm:rounded-t-[300px] sm:px-12 sm:pb-20 sm:pt-28">
                <div class="absolute inset-3 rounded-t-[170px] border border-[#6f4614]/50 sm:rounded-t-[290px]"></div>
                <div class="relative">
                  <div class="text-3xl text-[#6f4614] sm:text-4xl">♔</div>
                  <p class="mt-5 text-[9px] font-bold uppercase tracking-[.55em] text-[#241608]">THE MELAGRAM</p>
                  <h1 class="display mt-3 text-5xl leading-none tracking-[.08em] text-[#100b08] sm:text-7xl">CREATORS</h1>
                  <h2 class="display mt-1 text-4xl tracking-[.15em] text-[#241608] sm:text-6xl">VAULT</h2>
                  <div class="mx-auto mt-6 h-px w-24 bg-[#6f4614]"></div>
                  <p class="mx-auto mt-6 max-w-lg text-[11px] font-semibold uppercase leading-6 tracking-[.16em] text-[#241608] sm:text-sm">Discover the people creating what comes next.</p>
                  <p class="mx-auto mt-4 max-w-md text-xs leading-6 text-[#3b2915]">A curated collection of Melagram members who have chosen to share their creative work and voice.</p>
                  <a href="#collection" class="mt-8 inline-flex rounded-xl border-2 border-[#d9ad55] bg-gradient-to-r from-[#3b0a68] to-[#17052a] px-8 py-4 text-[10px] font-bold uppercase tracking-[.2em] text-[#ffe8a6] shadow-[0_8px_25px_rgba(0,0,0,.3)] transition hover:-translate-y-1">Enter the Vault</a>
                </div>
              </div>
            </div>
            <div class="relative -mt-1 h-16 bg-[#050208]"><div class="absolute -top-8 left-1/2 h-16 w-[90%] -translate-x-1/2 rounded-[50%] border-t-4 border-[#d9ad55]"></div></div>
          </div>
        </div>
      </section>

      <section class="relative bg-[#050208] px-4 pb-16 sm:px-6 lg:px-10">
        <div class="absolute inset-x-0 top-0 h-32 bg-[radial-gradient(circle_at_center,rgba(109,25,201,.15),transparent_70%)]"></div>
        <div class="relative mx-auto max-w-7xl">
          <div class="grid border-b border-[#d9ad55]/20 md:grid-cols-2 lg:grid-cols-3">
            {creatorCategories.map((category, index) => (
              <a href="#collection" class="group relative border-[#d9ad55]/20 px-6 py-9 text-center transition hover:bg-[#100618]/70 lg:px-8">
                {index > 0 && <div class="absolute left-0 top-1/2 hidden h-2/3 -translate-y-1/2 border-l border-[#d9ad55]/20 md:block"></div>}
                <div class="mx-auto grid h-16 w-16 place-items-center rounded-full border-2 border-[#d9ad55]/70 bg-gradient-to-br from-[#341052] to-[#100618] text-3xl text-[#ffe8a6] shadow-[0_0_25px_rgba(109,25,201,.2)] transition group-hover:scale-105">{category.icon}</div>
                <h3 class="display mt-5 text-2xl text-[#ffe8a6]">{category.title}</h3>
                <p class="mt-2 text-[8px] font-bold uppercase tracking-[.15em] text-[#d9ad55]">{category.subtitle}</p>
                <p class="mx-auto mt-4 max-w-xs text-xs leading-6 text-white/40">{category.description}</p>
                <div class="mt-5 inline-flex items-center gap-2 text-[9px] font-bold uppercase tracking-[.2em] text-[#ffe8a6]"><span>{creatorCounts.get(category.title) ?? 0}</span><span>{(creatorCounts.get(category.title) ?? 0) === 1 ? "Creator" : "Creators"}</span><span>→</span></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="collection" class="relative overflow-hidden bg-[#050208] px-5 py-16 sm:px-6 lg:px-10 lg:py-20">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(109,25,201,.16),transparent_55%)]"></div>
        <div class="relative mx-auto max-w-7xl">
          <div class="mb-12 flex items-center gap-4"><div class="gold-line flex-1"></div><h2 class="display shrink-0 text-2xl tracking-[.15em] text-[#ffe8a6] sm:text-4xl">VAULT MEMBERS</h2><div class="gold-line flex-1"></div></div>
          <p class="mx-auto -mt-6 mb-10 max-w-xl text-center text-sm text-white/40">Real Melagram creators who have chosen to be discoverable.</p>

          {creatorProfilesError ? (
            <div class="luxury-panel gold-border mx-auto max-w-2xl rounded-2xl p-10 text-center"><div class="gold-line mx-auto mb-7 w-24"></div><h3 class="font-serif text-2xl text-[#ffe8a6]">The Vault is temporarily unavailable.</h3><p class="mt-4 text-sm leading-7 text-white/50">We couldn't retrieve the current creator collection. Please refresh the page and try again.</p></div>
          ) : creators.length === 0 ? (
            <div class="luxury-panel gold-border mx-auto max-w-3xl rounded-3xl p-10 text-center sm:p-14">
              <div class="mx-auto grid h-20 w-20 place-items-center rounded-full border-2 border-[#d9ad55]/60 bg-gradient-to-br from-[#341052] to-[#100618] text-3xl text-[#ffe8a6]">♔</div>
              <p class="mt-7 text-[10px] font-bold uppercase tracking-[.45em] text-[#d9ad55]">THE VAULT AWAITS</p>
              <h3 class="mt-4 font-serif text-3xl text-[#ffe8a6] sm:text-4xl">Be one of the first creators.</h3>
              <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-white/50">Creator Profiles are opt-in. Turn on your Creator Profile in Edit Profile and choose your creative category to enter the Vault.</p>
              {currentUser ? <a href="/edit-profile" class="cta mt-8 inline-flex rounded-xl px-7 py-3 text-xs font-bold uppercase tracking-widest text-white">Enter the Vault</a> : <a href="/join" class="cta mt-8 inline-flex rounded-xl px-7 py-3 text-xs font-bold uppercase tracking-widest text-white">Join Melagram</a>}
            </div>
          ) : (
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {creators.map((creator) => {
                const displayName = getDisplayName(creator);
                const category = creator.creator_category || "Creator";
                const description = creator.bio?.trim() || getCategoryDescription(creator.creator_category);
                return (
                  <article class="group relative overflow-hidden border border-[#d9ad55]/50 bg-gradient-to-b from-[#180b24] to-[#08040d] p-5 shadow-[0_15px_45px_rgba(0,0,0,.35)] transition hover:-translate-y-2 hover:border-[#d9ad55]">
                    <div class="absolute left-2 top-2 h-7 w-7 border-l border-t border-[#d9ad55]"></div><div class="absolute right-2 top-2 h-7 w-7 border-r border-t border-[#d9ad55]"></div><div class="absolute bottom-2 left-2 h-7 w-7 border-b border-l border-[#d9ad55]"></div><div class="absolute bottom-2 right-2 h-7 w-7 border-b border-r border-[#d9ad55]"></div>
                    <div class="relative">
                      <div class="mx-auto grid h-36 w-36 place-items-center overflow-hidden rounded-full border-4 border-[#d9ad55]/80 bg-gradient-to-br from-[#32104d] to-[#0b040f] text-3xl font-bold text-[#ffe8a6] shadow-[0_0_35px_rgba(109,25,201,.25)]">
                        {creator.avatar_url ? <img src={creator.avatar_url} alt={displayName} class="h-full w-full object-cover" loading="lazy" /> : getInitials(displayName)}
                      </div>
                      <div class="mt-6 text-center">
                        <span class="inline-flex rounded-full border border-[#d9ad55]/30 bg-[#160722] px-3 py-1 text-[8px] font-bold uppercase tracking-[.18em] text-[#d9ad55]">Vault Creator</span>
                        <h3 class="mt-4 font-serif text-2xl text-[#ffe8a6]">{displayName}</h3>
                        <p class="mt-2 text-[9px] font-bold uppercase tracking-[.2em] text-[#d9ad55]">{category}</p>
                        {creator.username && <p class="mt-2 text-xs text-white/35">@{creator.username}</p>}
                        <p class="mt-5 min-h-[72px] text-sm leading-7 text-white/50">{description}</p>
                        <a href={`/members/${creator.username}`} class="mt-6 inline-flex w-full items-center justify-center rounded-xl border border-[#d9ad55]/60 px-5 py-3 text-[10px] font-bold uppercase tracking-[.2em] text-[#ffe8a6] transition hover:bg-[#24102f] hover:text-white">View Creator Profile →</a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </div>
      </section>

      {creators.length > 0 && (
        <section class="border-y border-[#d9ad55]/20 bg-black/20 px-5 py-20 lg:px-10">
          <div class="mx-auto max-w-7xl">
            <div class="mb-12 text-center"><p class="text-[10px] font-bold uppercase tracking-[.5em] text-[#d9ad55]">CREATIVE VOICES</p><h2 class="mt-4 font-serif text-4xl text-[#fff4d4] sm:text-5xl">Find Your Creative Circle</h2><div class="gold-line mx-auto mt-6 w-28"></div><p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-white/55">Explore the people bringing music, stories, art, film, podcasts, and ideas to life across Melagram.</p></div>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {creatorCategories.map((category) => <div class="luxury-panel gold-border rounded-2xl p-7 text-center"><div class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#160722] text-2xl text-[#ffe8a6]">{category.icon}</div><h3 class="mt-5 font-serif text-2xl text-[#ffe8a6]">{category.title}</h3><p class="mt-3 text-sm leading-7 text-white/50">{creatorCounts.get(category.title) ?? 0} {(creatorCounts.get(category.title) ?? 0) === 1 ? "creator" : "creators"} currently in the Vault.</p></div>)}
            </div>
          </div>
        </section>
      )}

      <section class="px-5 py-20 lg:px-10">
        <div class="luxury-panel gold-border mx-auto max-w-5xl rounded-3xl p-10 text-center sm:p-14">
          <p class="text-[10px] font-bold uppercase tracking-[.5em] text-[#d9ad55]">YOUR CREATIVE VOICE</p>
          <h2 class="mt-5 font-serif text-4xl text-[#fff4d4] sm:text-5xl">Want a place in the Vault?</h2>
          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-white/55">Creator Profiles are completely optional. When you're ready, turn yours on from Edit Profile and choose the category that best represents your creative work.</p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            {currentUser ? <><a href="/edit-profile" class="cta inline-flex justify-center rounded-xl px-7 py-3 text-xs font-bold uppercase tracking-widest text-white">Edit Creator Profile</a><a href="/creators" class="inline-flex justify-center rounded-xl border border-[#d9ad55]/50 px-7 py-3 text-xs font-bold uppercase tracking-widest text-[#ffe8a6] transition hover:bg-[#24102f]">Refresh Vault</a></> : <><a href="/join" class="cta inline-flex justify-center rounded-xl px-7 py-3 text-xs font-bold uppercase tracking-widest text-white">Join Melagram</a><a href="/" class="inline-flex justify-center rounded-xl border border-[#d9ad55]/50 px-7 py-3 text-xs font-bold uppercase tracking-widest text-[#ffe8a6] transition hover:bg-[#24102f]">Return Home</a></>}
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#d9ad55]/20 bg-[#050208]">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-8 text-center text-xs text-[#fff7e5]/45 md:flex-row md:items-center md:justify-between md:text-left">
        <p>© 2026 Melagram. Connect. Network. Create. Build Community.</p>
        <div class="flex justify-center gap-5 md:justify-end"><a href="/about" class="hover:text-[#ffe8a6]">About</a><a href="/communities" class="hover:text-[#ffe8a6]">Communities</a><a href="/gossip" class="hover:text-[#ffe8a6]">Gossip</a><a href="/creators" class="hover:text-[#ffe8a6]">Creators</a></div>
      </div>
    </footer>
    <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>
  </div>
</body>
</html>
