---
import "../styles/global.css";
import { actions } from "astro:actions";
import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
  env: Astro.locals.runtime.env,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/login");
}

const displayName =
  user.user_metadata?.full_name ||
  user.user_metadata?.username ||
  user.email?.split("@")[0] ||
  "Member";

const username =
  user.user_metadata?.username ||
  user.email?.split("@")[0] ||
  "member";

const createPostResult = Astro.getActionResult(
  actions.createPost
);

const { data: communities } =
  await supabase
    .from("communities")
    .select("id, slug, name, icon, description")
    .order("created_at", { ascending: true });

const { data: memberships } =
  await supabase
    .from("community_members")
    .select("community_id")
    .eq("user_id", user.id);

const joinedCommunityIds = new Set(
  (memberships ?? []).map(
    (membership) => membership.community_id
  )
);

const joinedCommunities = (
  communities ?? []
).filter((community) =>
  joinedCommunityIds.has(community.id)
);

if (createPostResult?.data?.success) {
  return Astro.redirect("/dashboard");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Create Post | Melagram</title>
    <meta
      name="description"
      content="Create and share a post with the Melagram community."
    />
  </head>

  <body>
    <main class="min-h-screen px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <!-- Header -->
        <div class="mb-8 text-center">
          <div
            class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border border-[#d9ad55]/70 bg-[#16091f] shadow-[0_0_35px_rgba(109,25,201,.28)]"
          >
            <span class="text-2xl text-[#ffe8a6]">✦</span>
          </div>

          <p
            class="mb-2 text-xs font-semibold uppercase tracking-[0.35em] text-[#d9ad55]"
          >
            Melagram
          </p>

          <h1
            class="display text-3xl font-semibold text-[#fff7e5] sm:text-4xl"
          >
            Create a Post
          </h1>

          <p class="mt-3 text-sm text-[#cdbfd8] sm:text-base">
            Share something with the Melagram community.
          </p>
        </div>

        <!-- Main Card -->
        <section
          class="luxury-panel gold-border overflow-hidden rounded-2xl"
        >
          <!-- Member Header -->
          <div
            class="flex items-center gap-4 border-b border-[#d9ad55]/30 px-5 py-5 sm:px-7"
          >
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#d9ad55]/70 bg-[#0b050f] text-lg font-semibold text-[#ffe8a6]"
            >
              {displayName.charAt(0).toUpperCase()}
            </div>

            <div class="min-w-0">
              <h2
                class="truncate text-base font-semibold text-[#fff7e5]"
              >
                {displayName}
              </h2>

              <p class="truncate text-sm text-[#a894b7]">
                @{username}
              </p>
            </div>
          </div>

          <!-- Form -->
          <form
            method="POST"
            enctype="multipart/form-data"
            action={actions.createPost}
            class="p-5 sm:p-7"
            id="create-post-form"
          >
            {
              createPostResult?.error && (
                <div
                  class="mb-5 rounded-xl border border-red-400/40 bg-red-950/30 px-4 py-3 text-sm text-red-200"
                >
                  {createPostResult.error.message ||
                    "We couldn't publish your post. Please try again."}
                </div>
              )
            }

            {
              createPostResult?.data &&
              !createPostResult.data.success && (
                <div
                  class="mb-5 rounded-xl border border-red-400/40 bg-red-950/30 px-4 py-3 text-sm text-red-200"
                >
                  {createPostResult.data.message}
                </div>
              )
            }

            <!-- Post Label -->
            <div class="mb-3 flex items-center justify-between">
              <label
                for="content"
                class="text-xs font-semibold uppercase tracking-[0.2em] text-[#d9ad55]"
              >
                What's on your mind?
              </label>

              <span
                id="character-count"
                class="text-xs text-[#a894b7]"
              >
                0 / 2000
              </span>
            </div>

            <!-- Textarea -->
            <textarea
              id="content"
              name="content"
              rows="9"
              maxlength="2000"
              required
              placeholder="Write something..."
              class="block w-full resize-y rounded-xl border border-[#d9ad55]/70 bg-black px-4 py-4 text-base leading-7 text-[#b84cff] outline-none transition placeholder:text-[#7f4c9b] focus:border-[#ffe8a6] focus:ring-1 focus:ring-[#d9ad55]/60"
            ></textarea>

            <!-- Composer Tools -->
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
              <label
                for="image"
                class="group flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-xl border border-[#d9ad55]/40 bg-black/30 px-4 text-xs font-bold uppercase tracking-[0.12em] text-[#ffe8a6] transition hover:border-[#d9ad55]/80 hover:bg-[#16091f]"
              >
                <span class="text-base">📸</span>
                <span>Add Photo</span>
              </label>

              <button
                type="button"
                id="link-tool-btn"
                class="flex min-h-12 items-center justify-center gap-2 rounded-xl border border-[#d9ad55]/40 bg-black/30 px-4 text-xs font-bold uppercase tracking-[0.12em] text-[#ffe8a6] transition hover:border-[#d9ad55]/80 hover:bg-[#16091f]"
              >
                <span class="text-base">🔗</span>
                <span>Add Link</span>
              </button>

              <button
                type="button"
                id="music-tool-btn"
                class="flex min-h-12 items-center justify-center gap-2 rounded-xl border border-[#d9ad55]/40 bg-black/30 px-4 text-xs font-bold uppercase tracking-[0.12em] text-[#ffe8a6] transition hover:border-[#d9ad55]/80 hover:bg-[#16091f]"
              >
                <span class="text-base">🎵</span>
                <span>Music / Video</span>
              </button>
            </div>

            <p
              id="link-helper"
              class="mt-3 hidden rounded-xl border border-[#d9ad55]/20 bg-[#16091f]/60 px-4 py-3 text-xs leading-5 text-[#b9a9c2]"
            >
              Paste a URL directly into your post. Melagram will automatically
              create a rich preview when one is available.
            </p>

            <!-- Photo Upload -->
            <div
              class="mt-6 rounded-xl border border-dashed border-[#d9ad55]/40 bg-black/40 p-5"
            >
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#d9ad55]/40 bg-[#16091f] text-[#d9ad55]"
                >
                  <span class="text-lg">📷</span>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <h3
                        class="text-sm font-semibold text-[#fff7e5]"
                      >
                        Add a Photo
                      </h3>

                      <p class="mt-1 text-sm leading-6 text-[#9e8ba9]">
                        Share a JPG, PNG, WEBP, or GIF with your post.
                        Maximum 10MB.
                      </p>
                    </div>

                    <label
                      for="image"
                      class="mt-3 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-[#d9ad55]/60 px-5 text-xs font-bold uppercase tracking-[0.16em] text-[#ffe8a6] transition hover:border-[#ffe8a6] hover:bg-[#16091f] sm:mt-0"
                    >
                      Choose Photo
                    </label>
                  </div>

                  <input
                    id="image"
                    name="image"
                    type="file"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                    class="sr-only"
                  />

                  <div
                    id="image-preview-wrap"
                    class="mt-5 hidden overflow-hidden rounded-xl border border-[#d9ad55]/30 bg-black"
                  >
                    <div class="relative">
                      <img
                        id="image-preview"
                        src=""
                        alt="Selected post preview"
                        class="max-h-[28rem] w-full object-contain"
                      />

                      <button
                        type="button"
                        id="remove-image-btn"
                        class="absolute right-3 top-3 rounded-full border border-white/20 bg-black/80 px-3 py-2 text-xs font-semibold text-white backdrop-blur transition hover:border-[#ffe8a6] hover:text-[#ffe8a6]"
                      >
                        Remove
                      </button>
                    </div>
                  </div>

                  <p
                    id="image-file-name"
                    class="mt-3 hidden text-xs text-[#d9ad55]"
                  ></p>

                  <p
                    id="image-error"
                    class="mt-3 hidden text-xs text-red-300"
                  ></p>
                </div>
              </div>
            </div>

            <!-- Post Destination -->
            <div class="mt-6 rounded-xl border border-[#d9ad55]/40 bg-black/40 p-5">
              <div class="flex items-start gap-3">
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#d9ad55]/40 bg-[#16091f] text-[#d9ad55]"
                >
                  <span class="text-lg">📍</span>
                </div>

                <div class="min-w-0 flex-1">
                  <label
                    for="communitySlug"
                    class="text-xs font-semibold uppercase tracking-[0.2em] text-[#d9ad55]"
                  >
                    Post to
                  </label>

                  <select
                    id="communitySlug"
                    name="communitySlug"
                    class="mt-3 block min-h-12 w-full rounded-xl border border-[#d9ad55]/60 bg-black px-4 text-sm font-semibold text-[#fff7e5] outline-none transition focus:border-[#ffe8a6] focus:ring-1 focus:ring-[#d9ad55]/50"
                  >
                    <option value="">🏠 Melagram Feed</option>

                    {
                      joinedCommunities.map((community) => (
                        <option value={community.slug}>
                          {community.icon || "✦"} {community.name}
                        </option>
                      ))
                    }
                  </select>

                  <p class="mt-2 text-xs leading-5 text-[#9e8ba9]">
                    You can post to communities you've joined. Join a community
                    first if you want to publish there.
                  </p>

                  {
                    joinedCommunities.length === 0 && (
                      <a
                        href="/communities"
                        class="mt-3 inline-flex text-xs font-semibold uppercase tracking-[0.14em] text-[#ffe8a6] hover:text-white"
                      >
                        Explore Communities →
                      </a>
                    )
                  }
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div
              class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
            >
              <a
                href="/dashboard"
                class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#d9ad55]/50 bg-black/40 px-6 text-sm font-semibold text-[#fff7e5] transition hover:border-[#ffe8a6] hover:bg-[#16091f]"
              >
                Cancel
              </a>

              <button
                type="submit"
                id="publish-btn"
                class="cta inline-flex min-h-12 items-center justify-center rounded-xl px-7 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50"
              >
                Publish Post
              </button>
            </div>
          </form>
        </section>

        <!-- Footer -->
        <div class="mt-6 text-center">
          <a
            href="/dashboard"
            class="nav-link text-sm text-[#a894b7] hover:text-[#ffe8a6]"
          >
            ← Back to Dashboard
          </a>
        </div>
      </div>
    </main>

    <script>
      const form = document.getElementById(
        "create-post-form"
      ) as HTMLFormElement | null;

      const textarea = document.getElementById(
        "content"
      ) as HTMLTextAreaElement | null;

      const characterCount = document.getElementById(
        "character-count"
      ) as HTMLSpanElement | null;

      const publishButton = document.getElementById(
        "publish-btn"
      ) as HTMLButtonElement | null;

      const imageInput = document.getElementById(
        "image"
      ) as HTMLInputElement | null;

      const imagePreviewWrap = document.getElementById(
        "image-preview-wrap"
      ) as HTMLDivElement | null;

      const imagePreview = document.getElementById(
        "image-preview"
      ) as HTMLImageElement | null;

      const imageFileName = document.getElementById(
        "image-file-name"
      ) as HTMLParagraphElement | null;

      const imageError = document.getElementById(
        "image-error"
      ) as HTMLParagraphElement | null;

      const removeImageButton = document.getElementById(
        "remove-image-btn"
      ) as HTMLButtonElement | null;

      const linkToolButton = document.getElementById(
        "link-tool-btn"
      ) as HTMLButtonElement | null;

      const musicToolButton = document.getElementById(
        "music-tool-btn"
      ) as HTMLButtonElement | null;

      const linkHelper = document.getElementById(
        "link-helper"
      ) as HTMLParagraphElement | null;

      let selectedImageUrl: string | null = null;

      const clearImageError = () => {
        if (!imageError) return;

        imageError.textContent = "";
        imageError.classList.add("hidden");
      };

      const showImageError = (message: string) => {
        if (!imageError) return;

        imageError.textContent = message;
        imageError.classList.remove("hidden");
      };

      const resetImagePreview = () => {
        if (selectedImageUrl) {
          URL.revokeObjectURL(selectedImageUrl);
          selectedImageUrl = null;
        }

        if (imageInput) {
          imageInput.value = "";
        }

        imagePreview?.setAttribute("src", "");
        imagePreviewWrap?.classList.add("hidden");

        if (imageFileName) {
          imageFileName.textContent = "";
          imageFileName.classList.add("hidden");
        }

        clearImageError();
      };

      const handleImageSelection = () => {
        clearImageError();

        const file = imageInput?.files?.[0];

        if (!file) {
          resetImagePreview();
          return;
        }

        const allowedTypes = [
          "image/jpeg",
          "image/png",
          "image/webp",
          "image/gif",
        ];

        if (!allowedTypes.includes(file.type)) {
          resetImagePreview();
          showImageError(
            "Please choose a JPG, PNG, WEBP, or GIF image."
          );
          return;
        }

        const maxSize =
          10 * 1024 * 1024;

        if (file.size > maxSize) {
          resetImagePreview();
          showImageError(
            "Post images must be 10MB or smaller."
          );
          return;
        }

        if (selectedImageUrl) {
          URL.revokeObjectURL(selectedImageUrl);
        }

        selectedImageUrl =
          URL.createObjectURL(file);

        if (imagePreview) {
          imagePreview.src =
            selectedImageUrl;
        }

        imagePreviewWrap?.classList.remove(
          "hidden"
        );

        if (imageFileName) {
          imageFileName.textContent =
            file.name;

          imageFileName.classList.remove(
            "hidden"
          );
        }
      };

      imageInput?.addEventListener(
        "change",
        handleImageSelection
      );

      removeImageButton?.addEventListener(
        "click",
        resetImagePreview
      );

      const focusLinkComposer = () => {
        textarea?.focus();

        if (textarea) {
          textarea.placeholder =
            "Write your post and paste a link here...";
        }

        linkHelper?.classList.remove(
          "hidden"
        );
      };

      linkToolButton?.addEventListener(
        "click",
        focusLinkComposer
      );

      musicToolButton?.addEventListener(
        "click",
        focusLinkComposer
      );

      const updateCharacterCount = () => {
        if (!textarea || !characterCount) return;

        const length = textarea.value.length;

        characterCount.textContent = `${length} / 2000`;

        if (length >= 1900) {
          characterCount.classList.add("text-[#ffe8a6]");
        } else {
          characterCount.classList.remove("text-[#ffe8a6]");
        }
      };

      textarea?.addEventListener(
        "input",
        updateCharacterCount
      );

      form?.addEventListener("submit", () => {
        if (!publishButton || !textarea) return;

        if (!textarea.value.trim()) {
          return;
        }

        publishButton.disabled = true;
        publishButton.textContent = "Publishing...";
      });

      updateCharacterCount();
    </script>
  </body>
</html>
