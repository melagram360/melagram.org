---
import "../styles/global.css";
import { createClient } from "../lib/supabase";
import { actions } from "astro:actions";
import LinkPreview from "../components/LinkPreview.astro";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/login");
}

const displayName =
  user.user_metadata?.full_name ||
  user.user_metadata?.username ||
  user.email?.split("@")[0] ||
  "Member";

const signOutResult =
  Astro.getActionResult(actions.signOut);

if (signOutResult?.data?.success) {
  return Astro.redirect("/");
}

/* --------------------------------
   NOTIFICATIONS
--------------------------------- */

const {
  count: unreadNotificationCount,
} = await supabase
  .from("notifications")
  .select("id", {
    count: "exact",
    head: true,
  })
  .eq("recipient_id", user.id)
  .eq("is_read", false);
/* --------------------------------
   UNREAD MESSAGES
--------------------------------- */

const {
  count: unreadMessageCount,
} = await supabase
  .from("messages")
  .select("id", {
    count: "exact",
    head: true,
  })
  .neq("sender_id", user.id)
  .is("read_at", null);

/* --------------------------------
   PEOPLE I FOLLOW
--------------------------------- */

const {
  data: followingRows,
  error: followingError,
} = await supabase
  .from("follows")
  .select("following_id")
  .eq("follower_id", user.id);

const followingIds =
  (followingRows ?? []).map(
    (follow) => follow.following_id
  );

/* --------------------------------
   FEED USER IDS

   Always include yourself.
--------------------------------- */

const feedUserIds = [
  user.id,
  ...followingIds.filter(
    (id) => id !== user.id
  ),
];

/* --------------------------------
   SOCIAL FEED
--------------------------------- */

let posts = [];
let postsError = null;

if (
  !followingError &&
  feedUserIds.length > 0
) {
  const result = await supabase
    .from("posts")
    .select(
      "id, user_id, content, image_url, created_at, community_slug, link_url, link_type, link_title, link_description, link_image_url"
    )
    .in("user_id", feedUserIds)
    .order("created_at", {
      ascending: false,
    });

  posts = result.data ?? [];
  postsError = result.error;
}

let feedPosts = [];

if (
  !postsError &&
  posts.length > 0
) {
  const userIds = [
    ...new Set(
      posts.map(
        (post) => post.user_id
      )
    ),
  ];

  /* --------------------------------
     PROFILES
  --------------------------------- */

  const {
    data: profiles,
  } = await supabase
    .from("profiles")
    .select(
      "id, username, full_name, avatar_url"
    )
    .in("id", userIds);

  const profileMap = new Map(
    (profiles ?? []).map(
      (profile) => [
        profile.id,
        profile,
      ]
    )
  );

  /* --------------------------------
     LIKES
  --------------------------------- */

  const {
    data: likes,
    error: likesError,
  } = await supabase
    .from("post_likes")
    .select(
      "post_id, user_id"
    )
    .in("post_id", posts.map((post) => post.id));

  const likeCountMap = new Map();

  const likedByCurrentUser =
    new Set();

  if (
    !likesError &&
    likes
  ) {
    for (
      const like of likes
    ) {
      likeCountMap.set(
        like.post_id,
        (
          likeCountMap.get(
            like.post_id
          ) ?? 0
        ) + 1
      );

      if (
        like.user_id ===
        user.id
      ) {
        likedByCurrentUser.add(
          like.post_id
        );
      }
    }
  }

  /* --------------------------------
     COMMENTS
  --------------------------------- */

  const {
    data: comments,
    error: commentsError,
  } = await supabase
    .from("post_comments")
    .select(
      "id, post_id, user_id, content, created_at, parent_comment_id"
    )
    .in(
      "post_id",
      posts.map((post) => post.id)
    )
    .order("created_at", {
      ascending: true,
    });

  const commentCountMap =
    new Map();

  if (
    !commentsError &&
    comments
  ) {
    for (
      const comment of comments
    ) {
      commentCountMap.set(
        comment.post_id,
        (
          commentCountMap.get(
            comment.post_id
          ) ?? 0
        ) + 1
      );
    }
  }

  /* --------------------------------
     COMMENTER PROFILES
  --------------------------------- */

  const commentUserIds =
    !commentsError &&
    comments
      ? comments.map(
          (comment) =>
            comment.user_id
        )
      : [];

  const allProfileIds = [
    ...new Set([
      ...userIds,
      ...commentUserIds,
    ]),
  ];

  const {
    data: allProfiles,
  } =
    await supabase
      .from("profiles")
      .select(
        "id, username, full_name, avatar_url"
      )
      .in(
        "id",
        allProfileIds
      );

  const allProfileMap = new Map(
    (
      allProfiles ??
      profiles ??
      []
    ).map(
      (profile) => [
        profile.id,
        profile,
      ]
    )
  );

  /* --------------------------------
     COMMENTS BY POST
  --------------------------------- */

  const commentsByPost =
    new Map();

  if (
    !commentsError &&
    comments
  ) {
    const commentsWithProfiles =
      comments.map(
        (comment) => ({
          ...comment,
          profile:
            allProfileMap.get(
              comment.user_id
            ) ?? null,
          replies: [],
        })
      );

    const commentMap =
      new Map(
        commentsWithProfiles.map(
          (comment) => [
            comment.id,
            comment,
          ]
        )
      );

    for (
      const comment of commentsWithProfiles
    ) {
      if (
        comment.parent_comment_id
      ) {
        const parent =
          commentMap.get(
            comment.parent_comment_id
          );

        if (parent) {
          parent.replies.push(
            comment
          );
        }
      } else {
        const existing =
          commentsByPost.get(
            comment.post_id
          ) ?? [];

        existing.push(
          comment
        );

        commentsByPost.set(
          comment.post_id,
          existing
        );
      }
    }
  }

  /* --------------------------------
     FINAL FEED
  --------------------------------- */

  feedPosts =
    posts.map(
      (post) => ({
        ...post,

        profile:
          allProfileMap.get(
            post.user_id
          ) ??
          profileMap.get(
            post.user_id
          ) ??
          null,

        likeCount:
          likeCountMap.get(
            post.id
          ) ?? 0,

        likedByCurrentUser:
          likedByCurrentUser.has(
            post.id
          ),

        commentCount:
          commentCountMap.get(
            post.id
          ) ?? 0,

        comments:
          commentsByPost.get(
            post.id
          ) ?? [],
      })
    );
}
---

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      Melagram — Dashboard
    </title>

  </head>


  <body>

    <main
      class="min-h-screen bg-[#050208] text-[#fff7e5]"
    >

      <!-- ================================================= -->
      <!-- NAVIGATION -->
      <!-- ================================================= -->

      <nav
        class="border-b border-[#d9ad55]/20 bg-black/40 backdrop-blur-xl"
      >

        <div
          class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8"
        >

          <a
            href="/"
            class="flex items-center gap-3"
          >

            <div
              class="flex h-10 w-10 items-center justify-center rounded-full border border-[#d9ad55]/60 bg-[#6d19c9]/20 text-lg font-semibold text-[#ffe8a6]"
            >
              M
            </div>

            <span
              class="font-['Cinzel'] text-lg tracking-[0.18em] text-[#ffe8a6]"
            >
              MELAGRAM
            </span>

          </a>


          <div
            class="hidden items-center gap-7 text-sm text-white/70 md:flex"
          >

            <a
              href="/discover"
              class="nav-link"
            >
              Discover
            </a>

            <a
              href="/communities"
              class="nav-link"
            >
              Communities
            </a>

            <a
              href="/creators"
              class="nav-link"
            >
              Creators
            </a>

            <a
              href="/search"
              class="nav-link"
            >
              Search
            </a>

          </div>


          <div
            class="flex items-center gap-2"
          >

            <a
              href="/messages"
              aria-label="Messages"
              class="relative inline-flex items-center justify-center rounded-full border border-[#d9ad55]/50 px-3 py-2 text-sm text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
            >
              <span aria-hidden="true">
                💬
              </span>

              <span
                class="ml-1 hidden sm:inline"
              >
                Messages
              </span>

              {unreadMessageCount &&
                unreadMessageCount > 0 && (

                <span
                  class="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#6d19c9] px-1 text-[10px] font-bold text-white ring-2 ring-black"
                >
                  {unreadMessageCount > 99
                    ? "99+"
                    : unreadMessageCount}
                </span>

              )}
            </a>


            <a
              href="/notifications"
              aria-label="Notifications"
              class="relative inline-flex items-center justify-center rounded-full border border-[#d9ad55]/50 px-3 py-2 text-sm text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
            >

              <span aria-hidden="true">
                🔔
              </span>

              <span
                class="ml-1 hidden sm:inline"
              >
                Notifications
              </span>


              {unreadNotificationCount &&
                unreadNotificationCount > 0 && (

                <span
                  class="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#6d19c9] px-1 text-[10px] font-bold text-white ring-2 ring-black"
                >
                  {unreadNotificationCount > 99
                    ? "99+"
                    : unreadNotificationCount}
                </span>

              )}

            </a>


            <a
              href="/profile"
              class="rounded-full border border-[#d9ad55]/50 px-4 py-2 text-sm text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
            >
              {displayName}
            </a>


            <button
              id="signout-btn"
              type="button"
              class="rounded-full border border-white/15 px-4 py-2 text-sm text-white/60 transition hover:border-[#d9ad55]/50 hover:text-[#ffe8a6]"
            >
              Sign Out
            </button>

          </div>

        </div>

      </nav>


      <!-- ================================================= -->
      <!-- WELCOME -->
      <!-- ================================================= -->

      <section
        class="relative overflow-hidden"
      >

        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(109,25,201,.28),transparent_42rem)]"
        ></div>


        <div
          class="relative mx-auto max-w-7xl px-5 py-14 sm:px-8 lg:py-20"
        >

          <div
            class="max-w-3xl"
          >

            <p
              class="mb-4 text-xs font-semibold uppercase tracking-[0.35em] text-[#d9ad55]"
            >
              Your Melagram
            </p>


            <h1
              class="text-4xl font-semibold leading-tight text-[#ffe8a6] sm:text-5xl lg:text-6xl"
            >
              Welcome Home.
            </h1>


            <p
              class="mt-5 max-w-2xl text-base leading-8 text-white/65 sm:text-lg"
            >
              This is your space to connect, discover
              new people, build communities, and share
              what makes you uniquely you.
            </p>

          </div>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- QUICK ACTIONS -->
      <!-- ================================================= -->

      <section
        class="mx-auto max-w-7xl px-5 pb-12 sm:px-8"
      >

        <div
          class="grid gap-5 md:grid-cols-3"
        >

          <a
            href="/discover"
            class="feature-card gold-border luxury-panel rounded-2xl p-6"
          >

            <p
              class="text-xs uppercase tracking-[0.25em] text-[#d9ad55]"
            >
              Explore
            </p>

            <h2
              class="mt-3 text-2xl text-[#ffe8a6]"
            >
              Discover
            </h2>

            <p
              class="mt-3 text-sm leading-7 text-white/60"
            >
              Find creators, communities,
              conversations, and people worth
              connecting with.
            </p>

          </a>


          <a
            href="/communities"
            class="feature-card gold-border luxury-panel rounded-2xl p-6"
          >

            <p
              class="text-xs uppercase tracking-[0.25em] text-[#d9ad55]"
            >
              Belong
            </p>

            <h2
              class="mt-3 text-2xl text-[#ffe8a6]"
            >
              Communities
            </h2>

            <p
              class="mt-3 text-sm leading-7 text-white/60"
            >
              Step into conversations built around
              the things you love.
            </p>

          </a>


          <a
            href="/creators"
            class="feature-card gold-border luxury-panel rounded-2xl p-6"
          >

            <p
              class="text-xs uppercase tracking-[0.25em] text-[#d9ad55]"
            >
              Create
            </p>

            <h2
              class="mt-3 text-2xl text-[#ffe8a6]"
            >
              Creators Vault
            </h2>

            <p
              class="mt-3 text-sm leading-7 text-white/60"
            >
              Discover creative work and eventually
              showcase your own.
            </p>

          </a>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- SOCIAL FEED -->
      <!-- ================================================= -->

      <section
        class="mx-auto max-w-7xl px-5 pb-20 sm:px-8"
      >

        <div
          class="grid gap-8 lg:grid-cols-[1fr_320px]"
        >

          <!-- FEED -->

          <div>

            <div
              class="mb-6 flex items-end justify-between"
            >

              <div>

                <p
                  class="text-xs uppercase tracking-[0.25em] text-[#d9ad55]"
                >
                  Social
                </p>


                <h2
                  class="mt-2 text-3xl text-[#ffe8a6]"
                >
                  Your Feed
                </h2>


                <p
                  class="mt-2 text-sm text-white/45"
                >
                  Posts from you and the people you follow.
                </p>

              </div>


              <a
                href="/create-post"
                class="hidden rounded-full bg-[#6d19c9] px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-purple-950/30 transition hover:bg-[#7d27dc] sm:inline-flex"
              >
                + Create Post
              </a>

            </div>


            <!-- MOBILE CREATE -->

            <a
              href="/create-post"
              class="mb-5 flex w-full items-center justify-center rounded-full bg-[#6d19c9] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#7d27dc] sm:hidden"
            >
              + Create Post
            </a>


            {postsError ? (

              <div
                class="gold-border luxury-panel rounded-2xl p-7"
              >

                <div
                  class="gold-line mb-6"
                ></div>

                <h3
                  class="text-xl text-[#ffe8a6]"
                >
                  Your feed couldn't load.
                </h3>

                <p
                  class="mt-3 text-sm leading-7 text-white/55"
                >
                  We had trouble retrieving your feed.
                  Please refresh the page and try again.
                </p>

              </div>

            ) : feedPosts.length === 0 ? (

              <div
                class="gold-border luxury-panel rounded-2xl p-7 sm:p-9"
              >

                <div
                  class="gold-line mb-7"
                ></div>

                <div
                  class="flex h-14 w-14 items-center justify-center rounded-full border border-[#d9ad55]/40 bg-[#6d19c9]/15 text-2xl text-[#ffe8a6]"
                >
                  ✦
                </div>


                <h3
                  class="mt-6 text-2xl text-[#ffe8a6]"
                >
                  Your Melagram starts here.
                </h3>


                <p
                  class="mt-4 max-w-2xl text-sm leading-7 text-white/60"
                >
                  You don't have any posts in your
                  network yet. Start the conversation
                  or discover people to follow.
                </p>


                <div
                  class="mt-7 flex flex-col gap-3 sm:flex-row"
                >

                  <a
                    href="/create-post"
                    class="cta inline-flex justify-center rounded-full px-6 py-3 text-sm font-semibold text-white"
                  >
                    Create a Post
                  </a>


                  <a
                    href="/discover"
                    class="inline-flex justify-center rounded-full border border-[#d9ad55]/50 px-6 py-3 text-sm font-semibold text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
                  >
                    Find People to Follow
                  </a>

                </div>

              </div>

            ) : (

              <div
                class="space-y-5"
              >

                {feedPosts.map(
                  (post) => {

                    const profile =
                      post.profile;

                    const postName =
                      profile?.full_name ||
                      profile?.username ||
                      "Melagram Member";

                    const username =
                      profile?.username
                        ? `@${profile.username}`
                        : "";

                    const avatarUrl =
                      profile?.avatar_url;

                    const postDate =
                      post.created_at
                        ? new Date(
                            post.created_at
                          ).toLocaleString(
                            "en-US",
                            {
                              month: "short",
                              day: "numeric",
                              year: "numeric",
                              hour: "numeric",
                              minute: "2-digit",
                            }
                          )
                        : "";

                    return (

                      <article
                        id={`post-${post.id}`}
                        class="gold-border luxury-panel rounded-2xl p-6 transition duration-300 hover:border-[#d9ad55]/50 sm:p-7"
                      >

                        <!-- AUTHOR -->

                        <div
                          class="flex items-start gap-4"
                        >

                          {avatarUrl ? (

                            <img
                              src={avatarUrl}
                              alt={postName}
                              class="h-12 w-12 shrink-0 rounded-full border border-[#d9ad55]/40 object-cover"
                            />

                          ) : (

                            <div
                              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#d9ad55]/40 bg-[#6d19c9]/20 text-lg font-semibold text-[#ffe8a6]"
                            >
                              {postName
                                .charAt(0)
                                .toUpperCase()}
                            </div>

                          )}


                          <div
                            class="min-w-0 flex-1"
                          >

                            <div
                              class="flex flex-wrap items-baseline gap-x-2 gap-y-1"
                            >

                              <span
                                class="font-semibold text-[#ffe8a6]"
                              >
                                {postName}
                              </span>


                              {username && (

                                <span
                                  class="text-sm text-white/40"
                                >
                                  {username}
                                </span>

                              )}

                            </div>


                            {postDate && (

                              <p
                                class="mt-1 text-xs text-white/35"
                              >
                                {postDate}
                              </p>

                            )}

                          </div>

                        </div>

                        {post.user_id === user.id && (

                          <div
                            class="mt-3 flex justify-end gap-2"
                          >

                            <button
                              type="button"
                              class="edit-post-toggle inline-flex items-center gap-2 rounded-full border border-white/10 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/45 transition hover:border-[#d9ad55]/40 hover:bg-[#6d19c9]/10 hover:text-[#ffe8a6]"
                              data-post-id={post.id}
                            >
                              ✏️ Edit
                            </button>

                          </div>

                        )}


                        <!-- CONTENT -->

                        <div
                          class="mt-5 border-t border-white/10 pt-5"
                        >

                          {post.community_slug && (

                            <a
                              href={`/communities/${post.community_slug}`}
                              class="mb-3 inline-flex rounded-full border border-[#d9ad55]/30 bg-[#6d19c9]/10 px-3 py-1 text-[10px] uppercase tracking-[0.15em] text-[#ffe8a6]"
                            >
                              {post.community_slug}
                            </a>

                          )}


                          <p
                            class="post-content whitespace-pre-wrap break-words text-[15px] leading-7 text-white/80"
                          >
                            {post.content}
                          </p>


                          <!-- ================================= -->
                          <!-- IMAGE -->
                          <!-- ================================= -->

                          {post.image_url && (

                            <div
                              class="mt-5 overflow-hidden rounded-2xl border border-[#d9ad55]/20 bg-black/20"
                            >

                              <img
                                src={post.image_url}
                                alt="Image shared in this post"
                                class="max-h-[650px] w-full object-contain"
                                loading="lazy"
                              />

                            </div>

                          )}


                          <!-- ================================= -->
                          <!-- RICH LINK PREVIEW -->
                          <!-- ================================= -->

                          {post.link_url &&
                            post.link_type && (

                            <LinkPreview
                              linkUrl={post.link_url}
                              linkType={post.link_type}
                              linkTitle={post.link_title}
                              linkDescription={post.link_description}
                              linkImageUrl={post.link_image_url}
                            />

                          )}

                        </div>

                        {post.user_id === user.id && (

                          <div
                            class="edit-post-area mt-5 hidden rounded-2xl border border-[#d9ad55]/25 bg-black/25 p-4"
                            data-post-id={post.id}
                          >

                            <p
                              class="text-xs font-semibold uppercase tracking-[0.18em] text-[#d9ad55]"
                            >
                              Edit Post
                            </p>

                            <textarea
                              class="edit-post-input mt-3 min-h-[130px] w-full resize-y rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-sm leading-7 text-white outline-none transition placeholder:text-white/25 focus:border-[#d9ad55]/50"
                              maxlength="2000"
                            >{post.content}</textarea>

                            <div class="mt-3 flex flex-wrap gap-2">

                              <button
                                type="button"
                                class="edit-post-save rounded-full bg-[#6d19c9] px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#7d27dc]"
                              >
                                Save Changes
                              </button>

                              <button
                                type="button"
                                class="edit-post-cancel rounded-full border border-white/10 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.12em] text-white/50 transition hover:border-[#d9ad55]/40 hover:text-[#ffe8a6]"
                              >
                                Cancel
                              </button>

                            </div>

                            <p
                              class="edit-post-message mt-2 hidden text-xs"
                            ></p>

                          </div>

                        )}


                        <!-- ENGAGEMENT -->

                        <div
                          class="mt-5 flex flex-wrap items-center gap-2 border-t border-white/10 pt-4"
                        >

                          <!-- LIKE -->

                          <button
                            type="button"
                            class:list={[
                              "like-btn",
                              "inline-flex",
                              "items-center",
                              "gap-2",
                              "rounded-full",
                              "px-3",
                              "py-2",
                              "text-xs",
                              "uppercase",
                              "tracking-[0.12em]",
                              post.likedByCurrentUser
                                ? "bg-[#6d19c9]/25 text-[#ffe8a6]"
                                : "text-white/40 hover:bg-[#6d19c9]/15 hover:text-[#ffe8a6]",
                            ]}
                            data-post-id={post.id}
                            aria-pressed={
                              post.likedByCurrentUser
                                ? "true"
                                : "false"
                            }
                          >

                            <span
                              class="like-icon text-base"
                            >
                              {post.likedByCurrentUser
                                ? "♥"
                                : "♡"}
                            </span>


                            <span
                              class="like-label"
                            >
                              {post.likedByCurrentUser
                                ? "Liked"
                                : "Like"}
                            </span>


                            <span
                              class="like-count"
                            >
                              {post.likeCount}
                            </span>

                          </button>


                          <!-- COMMENT -->

                          <button
                            type="button"
                            class="comment-toggle inline-flex items-center gap-2 rounded-full px-3 py-2 text-xs uppercase tracking-[0.12em] text-white/40 transition hover:bg-[#6d19c9]/15 hover:text-[#ffe8a6]"
                            data-post-id={post.id}
                          >

                            <span>
                              ○
                            </span>

                            <span>
                              Comment
                            </span>

                            <span
                              class="comment-count"
                            >
                              {post.commentCount}
                            </span>

                          </button>


                          <!-- SHARE -->

                          <button
                            type="button"
                            class="share-btn inline-flex items-center gap-2 rounded-full px-3 py-2 text-xs uppercase tracking-[0.12em] text-white/40 transition hover:bg-[#6d19c9]/15 hover:text-[#ffe8a6]"
                            data-post-id={post.id}
                          >

                            <span
                              class="share-icon"
                            >
                              ↗
                            </span>

                            <span
                              class="share-label"
                            >
                              Share
                            </span>

                          </button>

                        </div>


                        <!-- COMMENTS -->

                        <div
                          class="comment-area mt-4 hidden border-t border-white/10 pt-4"
                          data-post-id={post.id}
                        >

                          <div
                            class="comment-list space-y-3"
                          >

                            {post.comments.length > 0 ? (

                              post.comments.map(
                                (comment) => {

                                  const commentProfile =
                                    comment.profile;

                                  const commentName =
                                    commentProfile?.full_name ||
                                    commentProfile?.username ||
                                    "Melagram Member";

                                  const commentAvatar =
                                    commentProfile?.avatar_url;

                                  const commentDate =
                                    comment.created_at
                                      ? new Date(
                                          comment.created_at
                                        ).toLocaleString(
                                          "en-US",
                                          {
                                            month: "short",
                                            day: "numeric",
                                            hour: "numeric",
                                            minute: "2-digit",
                                          }
                                        )
                                      : "";

                                  return (

                                    <div
                                      class="comment-thread"
                                      data-comment-id={comment.id}
                                    >

                                      <!-- TOP-LEVEL COMMENT -->

                                      <div
                                        class="flex gap-3 rounded-xl border border-white/10 bg-black/20 p-3"
                                      >

                                        {commentAvatar ? (

                                          <img
                                            src={commentAvatar}
                                            alt={commentName}
                                            class="h-9 w-9 shrink-0 rounded-full border border-[#d9ad55]/30 object-cover"
                                          />

                                        ) : (

                                          <div
                                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#d9ad55]/30 bg-[#6d19c9]/15 text-sm font-semibold text-[#ffe8a6]"
                                          >
                                            {commentName
                                              .charAt(0)
                                              .toUpperCase()}
                                          </div>

                                        )}

                                        <div
                                          class="min-w-0 flex-1"
                                        >

                                          <div
                                            class="flex flex-wrap items-baseline gap-x-2"
                                          >

                                            <span
                                              class="text-sm font-semibold text-[#ffe8a6]"
                                            >
                                              {commentName}
                                            </span>

                                            {commentDate && (

                                              <span
                                                class="text-[11px] text-white/30"
                                              >
                                                {commentDate}
                                              </span>

                                            )}

                                          </div>

                                          <p
                                            class="mt-1 whitespace-pre-wrap text-sm leading-6 text-white/70"
                                          >
                                            {comment.content}
                                          </p>

                                          <button
                                            type="button"
                                            class="reply-toggle mt-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#d9ad55] transition hover:text-[#ffe8a6]"
                                            data-comment-id={comment.id}
                                          >
                                            Reply
                                          </button>

                                        </div>

                                      </div>

                                      <!-- REPLIES -->

                                      {comment.replies &&
                                        comment.replies.length > 0 && (

                                        <div
                                          class="ml-8 mt-2 space-y-2 border-l border-[#d9ad55]/20 pl-4"
                                        >

                                          {comment.replies.map(
                                            (reply) => {

                                              const replyProfile =
                                                reply.profile;

                                              const replyName =
                                                replyProfile?.full_name ||
                                                replyProfile?.username ||
                                                "Melagram Member";

                                              const replyAvatar =
                                                replyProfile?.avatar_url;

                                              const replyDate =
                                                reply.created_at
                                                  ? new Date(
                                                      reply.created_at
                                                    ).toLocaleString(
                                                      "en-US",
                                                      {
                                                        month: "short",
                                                        day: "numeric",
                                                        hour: "numeric",
                                                        minute: "2-digit",
                                                      }
                                                    )
                                                  : "";

                                              return (

                                                <div
                                                  class="flex gap-3 rounded-xl border border-white/10 bg-black/10 p-3"
                                                >

                                                  {replyAvatar ? (

                                                    <img
                                                      src={replyAvatar}
                                                      alt={replyName}
                                                      class="h-8 w-8 shrink-0 rounded-full border border-[#d9ad55]/25 object-cover"
                                                    />

                                                  ) : (

                                                    <div
                                                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d9ad55]/25 bg-[#6d19c9]/10 text-xs font-semibold text-[#ffe8a6]"
                                                    >
                                                      {replyName
                                                        .charAt(0)
                                                        .toUpperCase()}
                                                    </div>

                                                  )}

                                                  <div
                                                    class="min-w-0 flex-1"
                                                  >

                                                    <div
                                                      class="flex flex-wrap items-baseline gap-x-2"
                                                    >

                                                      <span
                                                        class="text-sm font-semibold text-[#ffe8a6]"
                                                      >
                                                        {replyName}
                                                      </span>

                                                      {replyDate && (

                                                        <span
                                                          class="text-[11px] text-white/30"
                                                        >
                                                          {replyDate}
                                                        </span>

                                                      )}

                                                    </div>

                                                    <p
                                                      class="mt-1 whitespace-pre-wrap text-sm leading-6 text-white/70"
                                                    >
                                                      {reply.content}
                                                    </p>

                                                  </div>

                                                </div>

                                              );

                                            }
                                          )}

                                        </div>

                                      )}

                                      <!-- REPLY FORM -->

                                      <form
                                        class="reply-form ml-8 mt-2 hidden flex gap-2 border-l border-[#d9ad55]/20 pl-4"
                                        data-post-id={post.id}
                                        data-parent-comment-id={comment.id}
                                      >

                                        <input
                                          type="text"
                                          name="content"
                                          maxlength="1000"
                                          required
                                          placeholder={`Reply to ${commentName}...`}
                                          class="min-w-0 flex-1 rounded-full border border-white/10 bg-black/30 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-[#d9ad55]/50"
                                        />

                                        <button
                                          type="submit"
                                          class="reply-submit rounded-full bg-[#6d19c9] px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#7d27dc]"
                                        >
                                          Reply
                                        </button>

                                        <button
                                          type="button"
                                          class="reply-cancel rounded-full border border-white/10 px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/50 transition hover:border-[#d9ad55]/40 hover:text-[#ffe8a6]"
                                        >
                                          Cancel
                                        </button>

                                      </form>

                                      <p
                                        class="reply-message ml-8 mt-1 hidden pl-4 text-xs text-red-300"
                                      ></p>

                                    </div>

                                  );

                                }
                              )                            ) : (

                              <p
                                class="py-2 text-sm text-white/35"
                              >
                                No comments yet. Be the
                                first to join the conversation.
                              </p>

                            )}

                          </div>


                          <form
                            class="comment-form mt-4 flex gap-2"
                            data-post-id={post.id}
                          >

                            <input
                              type="text"
                              name="content"
                              maxlength="1000"
                              required
                              placeholder="Write a comment..."
                              class="min-w-0 flex-1 rounded-full border border-white/10 bg-black/30 px-4 py-3 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-[#d9ad55]/50"
                            />


                            <button
                              type="submit"
                              class="comment-submit rounded-full bg-[#6d19c9] px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#7d27dc]"
                            >
                              Post
                            </button>

                          </form>


                          <p
                            class="comment-message mt-2 hidden text-xs text-red-300"
                          ></p>

                        </div>

                      </article>

                    );

                  }
                )}

              </div>

            )}

          </div>


          <!-- ================================================= -->
          <!-- SIDEBAR -->
          <!-- ================================================= -->

          <aside
            class="gold-border luxury-panel rounded-2xl p-6"
          >

            <p
              class="text-xs uppercase tracking-[0.25em] text-[#d9ad55]"
            >
              Member Area
            </p>


            <h2
              class="mt-3 text-2xl text-[#ffe8a6]"
            >
              Your Space
            </h2>


            <div
              class="gold-line my-5"
            ></div>


            <div
              class="space-y-4 text-sm text-white/60"
            >

              <a
                href="/profile"
                class="block rounded-xl border border-white/10 bg-black/20 p-4 transition hover:border-[#d9ad55]/30"
              >

                <p
                  class="text-[#ffe8a6]"
                >
                  Profile
                </p>

                <p class="mt-1">
                  Customize your Melagram identity.
                </p>

              </a>


              <a
                href="/discover"
                class="block rounded-xl border border-white/10 bg-black/20 p-4 transition hover:border-[#d9ad55]/30"
              >

                <p
                  class="text-[#ffe8a6]"
                >
                  Connections
                </p>

                <p class="mt-1">
                  Discover people and creators
                  to connect with.
                </p>

              </a>


              <a
                href="/messages"
                class="block rounded-xl border border-white/10 bg-black/20 p-4 transition hover:border-[#d9ad55]/30"
              >

                <p
                  class="text-[#ffe8a6]"
                >
                  Messages
                </p>

                <p class="mt-1">
                  Check your private conversations and messages.
                </p>

              </a>


              <a
                href="/notifications"
                class="block rounded-xl border border-white/10 bg-black/20 p-4 transition hover:border-[#d9ad55]/30"
              >

                <p
                  class="text-[#ffe8a6]"
                >
                  Notifications
                </p>

                <p class="mt-1">
                  Stay connected to what matters.
                </p>

              </a>

            </div>

          </aside>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- FOOTER -->
      <!-- ================================================= -->

      <footer
        class="border-t border-[#d9ad55]/15 px-5 py-8 sm:px-8"
      >

        <div
          class="mx-auto flex max-w-7xl flex-col gap-3 text-sm text-white/40 sm:flex-row sm:items-center sm:justify-between"
        >

          <p>
            © 2026 Melagram. Connect. Network. Create.
            Build Community.
          </p>


          <div
            class="flex gap-5"
          >

            <a
              href="/terms"
              class="hover:text-[#ffe8a6]"
            >
              Terms
            </a>

            <a
              href="/privacy"
              class="hover:text-[#ffe8a6]"
            >
              Privacy
            </a>

            <a
              href="/"
              class="text-[#d9ad55] hover:text-[#ffe8a6]"
            >
              Home
            </a>

          </div>

        </div>

      </footer>

    </main>


    <!-- ================================================= -->
    <!-- CLIENT INTERACTIONS -->
    <!-- ================================================= -->

    <script>

      import { actions } from "astro:actions";


      /* --------------------------------
         SIGN OUT
      --------------------------------- */

      const signOutButton =
        document.getElementById(
          "signout-btn"
        ) as HTMLButtonElement | null;


      signOutButton?.addEventListener(
        "click",
        async () => {

          signOutButton.disabled =
            true;

          signOutButton.textContent =
            "Signing Out...";


          const {
            data,
            error,
          } =
            await actions.signOut();


          if (
            error ||
            !data?.success
          ) {

            signOutButton.disabled =
              false;

            signOutButton.textContent =
              "Sign Out";

            alert(
              "We couldn't sign you out. Please try again."
            );

            return;
          }


          window.location.href =
            "/";

        }
      );


      /* --------------------------------
         LIKES
      --------------------------------- */

      const likeButtons =
        document.querySelectorAll(
          ".like-btn"
        );


      likeButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            async () => {

              const likeButton =
                button as HTMLButtonElement;

              const postId =
                likeButton.dataset.postId;

              if (!postId) {
                return;
              }

              if (
                likeButton.disabled
              ) {
                return;
              }


              likeButton.disabled =
                true;


              const {
                data,
                error,
              } =
                await actions.toggleLike({
                  postId,
                });


              if (
                error ||
                !data?.success
              ) {

                likeButton.disabled =
                  false;

                alert(
                  data?.message ||
                    "We couldn't update your like. Please try again."
                );

                return;
              }


              const liked =
                data.liked;


              likeButton.setAttribute(
                "aria-pressed",
                liked
                  ? "true"
                  : "false"
              );


              const icon =
                likeButton.querySelector(
                  ".like-icon"
                );

              const label =
                likeButton.querySelector(
                  ".like-label"
                );

              const count =
                likeButton.querySelector(
                  ".like-count"
                );


              if (icon) {
                icon.textContent =
                  liked
                    ? "♥"
                    : "♡";
              }


              if (label) {
                label.textContent =
                  liked
                    ? "Liked"
                    : "Like";
              }


              if (count) {

                const currentCount =
                  Number(
                    count.textContent ||
                      "0"
                  );

                count.textContent =
                  String(
                    liked
                      ? currentCount + 1
                      : Math.max(
                          0,
                          currentCount - 1
                        )
                  );

              }


              likeButton.classList.toggle(
                "bg-[#6d19c9]/25",
                liked
              );

              likeButton.classList.toggle(
                "text-[#ffe8a6]",
                liked
              );

              likeButton.classList.toggle(
                "text-white/40",
                !liked
              );

              likeButton.classList.toggle(
                "hover:bg-[#6d19c9]/15",
                !liked
              );

              likeButton.classList.toggle(
                "hover:text-[#ffe8a6]",
                !liked
              );


              likeButton.disabled =
                false;

            }
          );

        }
      );


      /* --------------------------------
         COMMENT TOGGLE
      --------------------------------- */

      const commentButtons =
        document.querySelectorAll(
          ".comment-toggle"
        );


      commentButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const postId =
                button.getAttribute(
                  "data-post-id"
                );

              if (!postId) {
                return;
              }


              const commentArea =
                document.querySelector(
                  `.comment-area[data-post-id="${postId}"]`
                );


              if (!commentArea) {
                return;
              }


              commentArea.classList.toggle(
                "hidden"
              );


              if (
                !commentArea.classList.contains(
                  "hidden"
                )
              ) {

                const input =
                  commentArea.querySelector(
                    'input[name="content"]'
                  ) as HTMLInputElement | null;

                input?.focus();

              }

            }
          );

        }
      );


      /* --------------------------------
         CREATE COMMENTS
      --------------------------------- */

      const commentForms =
        document.querySelectorAll(
          ".comment-form"
        );


      commentForms.forEach(
        (form) => {

          form.addEventListener(
            "submit",
            async (event) => {

              event.preventDefault();


              const commentForm =
                form as HTMLFormElement;


              const postId =
                commentForm.dataset.postId;


              const input =
                commentForm.querySelector(
                  'input[name="content"]'
                ) as HTMLInputElement | null;


              const submitButton =
                commentForm.querySelector(
                  ".comment-submit"
                ) as HTMLButtonElement | null;


              const message =
                commentForm.parentElement?.querySelector(
                  ".comment-message"
                ) as HTMLElement | null;


              if (
                !postId ||
                !input ||
                !submitButton
              ) {
                return;
              }


              const content =
                input.value.trim();


              if (!content) {
                return;
              }


              submitButton.disabled =
                true;

              submitButton.textContent =
                "Posting...";


              if (message) {
                message.classList.add(
                  "hidden"
                );
              }


              const {
                data,
                error,
              } =
                await actions.createComment({
                  postId,
                  content,
                  parentCommentId: null,
                });


              if (
                error ||
                !data?.success
              ) {

                submitButton.disabled =
                  false;

                submitButton.textContent =
                  "Post";


                if (message) {

                  message.textContent =
                    data?.message ||
                    "We couldn't post your comment. Please try again.";

                  message.classList.remove(
                    "hidden"
                  );

                }

                return;
              }


              window.location.reload();

            }
          );

        }
      );


      /* --------------------------------
         REPLY TO COMMENTS
      --------------------------------- */

      const replyButtons =
        document.querySelectorAll(
          ".reply-toggle"
        );


      replyButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const commentId =
                button.getAttribute(
                  "data-comment-id"
                );

              if (!commentId) {
                return;
              }


              const thread =
                button.closest(
                  ".comment-thread"
                );

              if (!thread) {
                return;
              }


              const replyForm =
                thread.querySelector(
                  ".reply-form"
                ) as HTMLFormElement | null;


              if (!replyForm) {
                return;
              }


              replyForm.classList.toggle(
                "hidden"
              );


              if (
                !replyForm.classList.contains(
                  "hidden"
                )
              ) {

                const input =
                  replyForm.querySelector(
                    'input[name="content"]'
                  ) as HTMLInputElement | null;

                input?.focus();

              }

            }
          );

        }
      );


      const replyCancelButtons =
        document.querySelectorAll(
          ".reply-cancel"
        );


      replyCancelButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const replyForm =
                button.closest(
                  ".reply-form"
                ) as HTMLFormElement | null;

              if (!replyForm) {
                return;
              }

              replyForm.classList.add(
                "hidden"
              );

              const input =
                replyForm.querySelector(
                  'input[name="content"]'
                ) as HTMLInputElement | null;

              if (input) {
                input.value = "";
              }

            }
          );

        }
      );


      const replyForms =
        document.querySelectorAll(
          ".reply-form"
        );


      replyForms.forEach(
        (form) => {

          form.addEventListener(
            "submit",
            async (event) => {

              event.preventDefault();


              const replyForm =
                form as HTMLFormElement;


              const postId =
                replyForm.dataset.postId;


              const parentCommentId =
                replyForm.dataset.parentCommentId;


              const input =
                replyForm.querySelector(
                  'input[name="content"]'
                ) as HTMLInputElement | null;


              const submitButton =
                replyForm.querySelector(
                  ".reply-submit"
                ) as HTMLButtonElement | null;


              const message =
                replyForm.parentElement?.querySelector(
                  ".reply-message"
                ) as HTMLElement | null;


              if (
                !postId ||
                !parentCommentId ||
                !input ||
                !submitButton
              ) {
                return;
              }


              const content =
                input.value.trim();


              if (!content) {
                return;
              }


              submitButton.disabled =
                true;

              submitButton.textContent =
                "Posting...";


              if (message) {
                message.classList.add(
                  "hidden"
                );
              }


              const {
                data,
                error,
              } =
                await actions.createComment({
                  postId,
                  content,
                  parentCommentId,
                });


              if (
                error ||
                !data?.success
              ) {

                submitButton.disabled =
                  false;

                submitButton.textContent =
                  "Reply";


                if (message) {

                  message.textContent =
                    data?.message ||
                    "We couldn't post your reply. Please try again.";

                  message.classList.remove(
                    "hidden"
                  );

                }

                return;
              }


              window.location.reload();

            }
          );

        }
      );


      /* --------------------------------
         EDIT POSTS
      --------------------------------- */

      const editToggleButtons =
        document.querySelectorAll(
          ".edit-post-toggle"
        );

      editToggleButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const postId =
                button.getAttribute(
                  "data-post-id"
                );

              if (!postId) {
                return;
              }

              const article =
                document.getElementById(
                  `post-${postId}`
                );

              if (!article) {
                return;
              }

              const editArea =
                article.querySelector(
                  ".edit-post-area"
                ) as HTMLElement | null;

              const contentParagraph =
                article.querySelector(
                  ".post-content"
                ) as HTMLElement | null;

              if (!editArea) {
                return;
              }

              editArea.classList.toggle(
                "hidden"
              );

              contentParagraph?.classList.toggle(
                "hidden",
                !editArea.classList.contains(
                  "hidden"
                )
              );

              if (
                !editArea.classList.contains(
                  "hidden"
                )
              ) {

                const input =
                  editArea.querySelector(
                    ".edit-post-input"
                  ) as HTMLTextAreaElement | null;

                input?.focus();
              }

            }
          );

        }
      );


      const editCancelButtons =
        document.querySelectorAll(
          ".edit-post-cancel"
        );

      editCancelButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const editArea =
                button.closest(
                  ".edit-post-area"
                ) as HTMLElement | null;

              if (!editArea) {
                return;
              }

              const article =
                editArea.closest(
                  "article"
                );

              editArea.classList.add(
                "hidden"
              );

              article
                ?.querySelector(
                  ".post-content"
                )
                ?.classList.remove(
                  "hidden"
                );

              const message =
                editArea.querySelector(
                  ".edit-post-message"
                ) as HTMLElement | null;

              message?.classList.add(
                "hidden"
              );

            }
          );

        }
      );


      const editSaveButtons =
        document.querySelectorAll(
          ".edit-post-save"
        );

      editSaveButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            async () => {

              const saveButton =
                button as HTMLButtonElement;

              const editArea =
                saveButton.closest(
                  ".edit-post-area"
                ) as HTMLElement | null;

              if (!editArea) {
                return;
              }

              const postId =
                editArea.dataset.postId;

              const input =
                editArea.querySelector(
                  ".edit-post-input"
                ) as HTMLTextAreaElement | null;

              const message =
                editArea.querySelector(
                  ".edit-post-message"
                ) as HTMLElement | null;

              if (
                !postId ||
                !input
              ) {
                return;
              }

              const content =
                input.value.trim();

              if (!content) {

                if (message) {
                  message.textContent =
                    "Please write something before saving.";
                  message.className =
                    "edit-post-message mt-2 text-xs text-red-300";
                }

                return;
              }

              if (content.length > 2000) {

                if (message) {
                  message.textContent =
                    "Your post must be 2,000 characters or fewer.";
                  message.className =
                    "edit-post-message mt-2 text-xs text-red-300";
                }

                return;
              }

              saveButton.disabled =
                true;

              saveButton.textContent =
                "Saving...";

              if (message) {
                message.className =
                  "edit-post-message mt-2 hidden text-xs";
              }

              const {
                data,
                error,
              } =
                await actions.updatePost({
                  postId,
                  content,
                });

              if (
                error ||
                !data?.success
              ) {

                saveButton.disabled =
                  false;

                saveButton.textContent =
                  "Save Changes";

                if (message) {
                  message.textContent =
                    data?.message ||
                    "We couldn't save your post changes. Please try again.";
                  message.className =
                    "edit-post-message mt-2 text-xs text-red-300";
                }

                return;
              }

              window.location.reload();

            }
          );

        }
      );


      /* --------------------------------
         SHARE POSTS
      --------------------------------- */

      const shareButtons =
        document.querySelectorAll(
          ".share-btn"
        );


      shareButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            async () => {

              const shareButton =
                button as HTMLButtonElement;

              const postId =
                shareButton.dataset.postId;


              if (!postId) {
                return;
              }


              if (
                shareButton.disabled
              ) {
                return;
              }


              const shareUrl =
                `${window.location.origin}/dashboard#post-${postId}`;


              const label =
                shareButton.querySelector(
                  ".share-label"
                );

              const icon =
                shareButton.querySelector(
                  ".share-icon"
                );


              shareButton.disabled =
                true;


              try {

                if (
                  navigator.share
                ) {

                  await navigator.share({
                    title:
                      "Melagram Post",
                    text:
                      "Check out this post on Melagram.",
                    url:
                      shareUrl,
                  });

                } else if (
                  navigator.clipboard
                ) {

                  await navigator.clipboard.writeText(
                    shareUrl
                  );

                } else {

                  const textarea =
                    document.createElement(
                      "textarea"
                    );

                  textarea.value =
                    shareUrl;

                  textarea.style.position =
                    "fixed";

                  textarea.style.opacity =
                    "0";

                  document.body.appendChild(
                    textarea
                  );

                  textarea.select();

                  document.execCommand(
                    "copy"
                  );

                  textarea.remove();

                }


                if (label) {
                  label.textContent =
                    "Copied!";
                }


                if (icon) {
                  icon.textContent =
                    "✓";
                }


                shareButton.classList.add(
                  "bg-[#6d19c9]/25",
                  "text-[#ffe8a6]"
                );


                window.setTimeout(
                  () => {

                    if (label) {
                      label.textContent =
                        "Share";
                    }

                    if (icon) {
                      icon.textContent =
                        "↗";
                    }

                    shareButton.classList.remove(
                      "bg-[#6d19c9]/25",
                      "text-[#ffe8a6]"
                    );

                    shareButton.disabled =
                      false;

                  },
                  1800
                );

              } catch (error) {

                console.error(
                  "Share error:",
                  error
                );

                shareButton.disabled =
                  false;

              }

            }
          );

        }
      );

    </script>

  </body>

</html>