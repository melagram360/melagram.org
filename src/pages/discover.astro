---
import "../styles/global.css";
import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user: currentUser },
} = await supabase.auth.getUser();

/* ========================================
   SEARCH
======================================== */

const searchQuery =
  Astro.url.searchParams.get("q")?.trim() || "";

const escapedSearch =
  searchQuery.replace(/[%_]/g, (character) => `\\${character}`);

/* ========================================
   MEMBERS
======================================== */

const { data: profiles } = await supabase
  .from("profiles")
  .select(
    "id, username, full_name, bio, avatar_url, created_at"
  )
  .order("created_at", { ascending: false })
  .limit(50);

let allProfiles = profiles ?? [];

if (searchQuery) {
  const query = searchQuery.toLowerCase();

  allProfiles = allProfiles.filter((member) => {
    const name =
      member.full_name?.toLowerCase() || "";

    const username =
      member.username?.toLowerCase() || "";

    const bio =
      member.bio?.toLowerCase() || "";

    return (
      name.includes(query) ||
      username.includes(query) ||
      bio.includes(query)
    );
  });
}

const members = currentUser
  ? allProfiles.filter(
      (member) => member.id !== currentUser.id
    )
  : allProfiles;

/* ========================================
   FOLLOWING DATA
======================================== */

let followingIds = new Set<string>();

if (
  currentUser &&
  members.length > 0
) {
  const memberIds = members.map(
    (member) => member.id
  );

  const { data: follows } =
    await supabase
      .from("follows")
      .select("following_id")
      .eq(
        "follower_id",
        currentUser.id
      )
      .in(
        "following_id",
        memberIds
      );

  followingIds = new Set(
    (follows ?? []).map(
      (follow) =>
        follow.following_id
    )
  );
}

/* ========================================
   COMMUNITIES
======================================== */

const { data: communities } =
  await supabase
    .from("communities")
    .select(
      "id, slug, name, description, category"
    )
    .order("name", {
      ascending: true,
    });

const communityList =
  communities ?? [];

const communityIds =
  communityList.map(
    (community) => community.id
  );

let communityMemberCounts =
  new Map<string, number>();

if (communityIds.length > 0) {
  const { data: memberships } =
    await supabase
      .from("community_members")
      .select("community_id")
      .in(
        "community_id",
        communityIds
      );

  const counts =
    new Map<string, number>();

  for (const membership of
    memberships ?? []) {
    counts.set(
      membership.community_id,
      (counts.get(
        membership.community_id
      ) ?? 0) + 1
    );
  }

  communityMemberCounts =
    counts;
}

/* ========================================
   TRENDING POSTS
======================================== */

const { data: trendingPosts } =
  await supabase
    .from("posts")
    .select(
      `
        id,
        user_id,
        content,
        image_url,
        created_at,
        community_slug,
        profiles!posts_user_id_fkey (
          username,
          full_name,
          avatar_url
        )
      `
    )
    .order("created_at", {
      ascending: false,
    })
    .limit(12);

const posts =
  trendingPosts ?? [];

const postIds =
  posts.map(
    (post) => post.id
  );

let likeCounts =
  new Map<string, number>();

let commentCounts =
  new Map<string, number>();

if (postIds.length > 0) {
  const { data: likes } =
    await supabase
      .from("likes")
      .select("post_id")
      .in(
        "post_id",
        postIds
      );

  for (const like of likes ?? []) {
    likeCounts.set(
      like.post_id,
      (likeCounts.get(
        like.post_id
      ) ?? 0) + 1
    );
  }

  const { data: comments } =
    await supabase
      .from("comments")
      .select("post_id")
      .in(
        "post_id",
        postIds
      );

  for (const comment of comments ?? []) {
    commentCounts.set(
      comment.post_id,
      (commentCounts.get(
        comment.post_id
      ) ?? 0) + 1
    );
  }
}

const trending = [...posts]
  .sort((a, b) => {
    const scoreA =
      (likeCounts.get(a.id) ?? 0) * 2 +
      (commentCounts.get(a.id) ?? 0) * 3;

    const scoreB =
      (likeCounts.get(b.id) ?? 0) * 2 +
      (commentCounts.get(b.id) ?? 0) * 3;

    return scoreB - scoreA;
  })
  .slice(0, 6);

/* ========================================
   COMMUNITY DISPLAY HELPERS
======================================== */

const communityIcons: Record<
  string,
  string
> = {
  "creative-minds": "🎨",
  "music-lounge": "🎵",
  "movie-tv-talk": "🎬",
  "food-flavor": "🍳",
  "travel-circle": "✈️",
  "real-talk": "💬",
};

const communityBySlug =
  new Map(
    communityList.map(
      (community) => [
        community.slug,
        community,
      ]
    )
  );

/* ========================================
   CREATOR CATEGORIES
======================================== */

const creatorCategories = [
  {
    icon: "♪",
    title: "Music",
    text:
      "Artists, producers, singers, and sound creators.",
  },
  {
    icon: "✒",
    title: "Writing",
    text:
      "Authors, poets, bloggers, and storytellers.",
  },
  {
    icon: "◈",
    title: "Art & Design",
    text:
      "Visual artists, designers, illustrators, and creatives.",
  },
  {
    icon: "▣",
    title: "Film & Video",
    text:
      "Filmmakers, directors, editors, and video creators.",
  },
];
