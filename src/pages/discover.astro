    <!-- FOLLOW INTERACTIONS -->

    <script>

      import { actions } from "astro:actions";


      const followButtons =
        document.querySelectorAll(
          ".followMemberButton"
        );


      followButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            async () => {

              const followButton =
                button as HTMLButtonElement;


              const userId =
                followButton.dataset.userId;


              if (!userId) {
                return;
              }


              if (
                followButton.disabled
              ) {
                return;
              }


              const currentlyFollowing =
                followButton.dataset.following ===
                "true";


              followButton.disabled =
                true;


              followButton.textContent =
                currentlyFollowing
                  ? "Unfollowing..."
                  : "Following...";


              const {
                data,
                error,
              } =
                await actions.toggleFollow({
                  userId,
                });


              if (
                error ||
                !data?.success
              ) {

                followButton.disabled =
                  false;


                followButton.textContent =
                  currentlyFollowing
                    ? "Following"
                    : "Follow";


                alert(
                  data?.message ||
                    "We couldn't update your follow."
                );

                return;

              }


              const following =
                data.following;


              followButton.dataset.following =
                following
                  ? "true"
                  : "false";


              followButton.textContent =
                following
                  ? "Following"
                  : "Follow";


              followButton.classList.toggle(
                "cta",
                !following
              );


              followButton.classList.toggle(
                "text-white",
                !following
              );


              followButton.classList.toggle(
                "border",
                following
              );


              followButton.classList.toggle(
                "border-[#d9ad55]/60",
                following
              );


              followButton.classList.toggle(
                "bg-[#24102f]",
                following
              );


              followButton.classList.toggle(
                "text-[#ffe8a6]",
                following
              );


              followButton.disabled =
                false;

            }
          );

        }
      );

