---
import "../styles/global.css";
import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
  env: Astro.locals.runtime.env,
});

const {
  data: { user: currentUser },
} = await supabase.auth.getUser();

const creatorPaths = [
  {
    icon: "♔",
    title: "Creators Vault",
    eyebrow: "DISCOVER",
    description: "Explore the artists, storytellers, visionaries, and builders shaping the Melagram community.",
    href: "/creators/vault",
    action: "Enter the Vault",
  },
  {
    icon: "✦",
    title: "Your Creative Space",
    eyebrow: "CREATE",
    description: "Share your work, build your audience, connect with your people, and make your presence known.",
    href: currentUser ? "/dashboard" : "/join",
    action: currentUser ? "Go to Dashboard" : "Become a Creator",
  },
];

const disciplines = [
  { icon: "♪", title: "Music", text: "Artists, producers, DJs & sound creators." },
  { icon: "✒", title: "Writing", text: "Authors, poets & storytellers." },
  { icon: "◈", title: "Art & Design", text: "Visual artists & designers." },
  { icon: "▣", title: "Film & Video", text: "Filmmakers, directors & video creators." },
  { icon: "♬", title: "Podcasting", text: "Hosts, commentators & broadcasters." },
  { icon: "◇", title: "Business", text: "Founders, entrepreneurs & visionaries." },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Creators on Melagram — discover, connect, create, and build your creative presence." />
    <title>Creators — Melagram</title>
  </head>

  <body>
    <div class="min-h-screen overflow-hidden bg-[#050208] text-white">
      <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>

      <header class="relative z-30 border-b border-[#d9ad55]/30 bg-[#050208]/95 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">
          <a href="/" class="flex items-center gap-3">
            <div class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#160722] text-xl text-[#ffe8a6]">♔</div>
            <span class="display hidden text-lg tracking-[.2em] text-[#ffe8a6] sm:block">MELAGRAM</span>
          </a>

          <div class="hidden items-center gap-7 text-[10px] font-bold uppercase tracking-[.22em] text-white/70 md:flex">
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/discover">Discover</a>
            <a class="nav-link" href="/communities">Communities</a>
            <a class="nav-link" href="/gossip">Gossip</a>
            <a class="nav-link text-[#ffe8a6]" href="/creators">Creators</a>
            <a class="nav-link" href="/about">About</a>
          </div>

          <div class="flex items-center gap-3">
            {currentUser ? (
              <>
                <a href="/dashboard" class="hidden text-[10px] font-bold uppercase tracking-wider text-white/60 transition hover:text-[#ffe8a6] sm:block">Dashboard</a>
                <a href="/profile" class="rounded-lg border border-[#d9ad55]/70 px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#d9ad55] hover:text-black">Profile</a>
              </>
            ) : (
              <>
                <a href="/login" class="hidden text-[10px] font-bold uppercase tracking-wider text-white/60 transition hover:text-[#ffe8a6] sm:block">Log In</a>
                <a href="/join" class="rounded-lg border border-[#d9ad55]/70 px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#d9ad55] hover:text-black">Join Melagram</a>
              </>
            )}
          </div>
        </nav>
      </header>

      <main>
        <section class="relative overflow-hidden bg-[#08030d]">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(109,25,201,.32),transparent_58%)]"></div>
          <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-[#6d19c9]/10 blur-3xl"></div>
          <div class="absolute -right-24 top-20 h-72 w-72 rounded-full bg-[#6d19c9]/10 blur-3xl"></div>

          <div class="relative mx-auto max-w-7xl px-5 pb-20 pt-16 sm:px-6 sm:pt-24 lg:px-10 lg:pb-28">
            <div class="mx-auto max-w-5xl text-center">
              <div class="mx-auto mb-7 flex w-fit items-center gap-3">
                <div class="h-px w-14 bg-[#d9ad55]/70 sm:w-20"></div>
                <span class="text-[9px] font-bold uppercase tracking-[.45em] text-[#d9ad55]">THE CREATOR HOUSE OF MELAGRAM</span>
                <div class="h-px w-14 bg-[#d9ad55]/70 sm:w-20"></div>
              </div>

              <div class="mx-auto grid h-20 w-20 place-items-center rounded-full border-2 border-[#d9ad55]/80 bg-gradient-to-br from-[#32104d] to-[#100618] text-4xl text-[#ffe8a6] shadow-[0_0_45px_rgba(109,25,201,.25)]">♔</div>
              <h1 class="display mt-8 text-6xl leading-none tracking-[.08em] text-[#ffe8a6] sm:text-8xl">CREATORS</h1>
              <div class="mx-auto mt-6 h-px w-28 bg-[#d9ad55]"></div>
              <p class="mx-auto mt-7 max-w-3xl text-sm font-semibold uppercase leading-7 tracking-[.16em] text-white/75 sm:text-base">Where ideas become culture, creativity becomes connection, and creators get their own place to shine.</p>
              <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-white/40 sm:text-base">Melagram is more than a place to post. It is a home for the people making music, telling stories, creating art, building businesses, filming worlds, and starting conversations.</p>

              <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="/creators/vault" class="rounded-xl border-2 border-[#d9ad55] bg-gradient-to-r from-[#ffe8a6] to-[#c6973e] px-8 py-4 text-[10px] font-bold uppercase tracking-[.2em] text-black shadow-[0_10px_30px_rgba(0,0,0,.35)] transition hover:-translate-y-1">Explore the Vault</a>
                <a href={currentUser ? "/dashboard" : "/join"} class="rounded-xl border border-[#d9ad55]/70 bg-[#160722] px-8 py-4 text-[10px] font-bold uppercase tracking-[.2em] text-[#ffe8a6] transition hover:-translate-y-1 hover:bg-[#24102f]">{currentUser ? "Create Something" : "Become a Creator"}</a>
              </div>
            </div>
          </div>
        </section>

        <section class="relative bg-[#050208] px-5 py-16 sm:px-6 lg:px-10 lg:py-20">
          <div class="relative mx-auto max-w-6xl">
            <div class="mb-12 text-center">
              <p class="text-[9px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">CHOOSE YOUR DOOR</p>
              <h2 class="display mt-3 text-3xl tracking-[.12em] text-[#ffe8a6] sm:text-5xl">THE CREATOR EXPERIENCE</h2>
              <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-white/40">Discover the creators already making moves — or step inside and start building your own creative presence.</p>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              {creatorPaths.map((path) => (
                <a href={path.href} class="group relative overflow-hidden border border-[#d9ad55]/40 bg-gradient-to-b from-[#180b24] to-[#08040d] p-8 shadow-[0_15px_45px_rgba(0,0,0,.3)] transition hover:-translate-y-2 hover:border-[#d9ad55] sm:p-10">
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(109,25,201,.18),transparent_55%)] opacity-70 transition group-hover:opacity-100"></div>
                  <div class="absolute left-3 top-3 h-8 w-8 border-l border-t border-[#d9ad55]/70"></div>
                  <div class="absolute right-3 top-3 h-8 w-8 border-r border-t border-[#d9ad55]/70"></div>
                  <div class="absolute bottom-3 left-3 h-8 w-8 border-b border-l border-[#d9ad55]/70"></div>
                  <div class="absolute bottom-3 right-3 h-8 w-8 border-b border-r border-[#d9ad55]/70"></div>

                  <div class="relative">
                    <div class="flex items-center justify-between gap-4">
                      <span class="text-[9px] font-bold uppercase tracking-[.35em] text-[#d9ad55]">{path.eyebrow}</span>
                      <span class="text-xl text-[#ffe8a6] transition group-hover:translate-x-1">→</span>
                    </div>
                    <div class="mt-7 grid h-16 w-16 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#160722] text-3xl text-[#ffe8a6]">{path.icon}</div>
                    <h3 class="display mt-6 text-3xl tracking-[.08em] text-[#ffe8a6]">{path.title}</h3>
                    <p class="mt-4 max-w-md text-sm leading-7 text-white/45">{path.description}</p>
                    <span class="mt-7 inline-flex rounded-lg border border-[#d9ad55]/60 px-5 py-3 text-[9px] font-bold uppercase tracking-[.2em] text-[#ffe8a6] transition group-hover:bg-[#d9ad55] group-hover:text-black">{path.action}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="relative overflow-hidden bg-[#08030d] px-5 py-16 sm:px-6 lg:px-10 lg:py-20">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(109,25,201,.12),transparent_65%)]"></div>
          <div class="relative mx-auto max-w-7xl">
            <div class="mb-12 flex items-center gap-4">
              <div class="gold-line flex-1"></div>
              <div class="text-center">
                <p class="text-[8px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">EVERY KIND OF CREATIVE</p>
                <h2 class="display mt-2 text-3xl tracking-[.12em] text-[#ffe8a6] sm:text-4xl">FIND YOUR LANE</h2>
              </div>
              <div class="gold-line flex-1"></div>
            </div>

            <div class="grid border-y border-[#d9ad55]/20 sm:grid-cols-2 lg:grid-cols-3">
              {disciplines.map((discipline, index) => (
                <a href="/creators/vault" class="group relative border-[#d9ad55]/20 px-6 py-8 transition hover:bg-[#100618]/70 lg:px-8">
                  {index > 0 && <div class="absolute left-0 top-1/2 hidden h-2/3 -translate-y-1/2 border-l border-[#d9ad55]/20 sm:block"></div>}
                  <div class="flex items-center gap-5">
                    <div class="grid h-14 w-14 shrink-0 place-items-center rounded-full border border-[#d9ad55]/60 bg-[#160722] text-2xl text-[#ffe8a6] transition group-hover:scale-105">{discipline.icon}</div>
                    <div>
                      <h3 class="display text-xl text-[#ffe8a6]">{discipline.title}</h3>
                      <p class="mt-1 text-xs leading-5 text-white/35">{discipline.text}</p>
                    </div>
                    <span class="ml-auto text-[#d9ad55] opacity-50 transition group-hover:translate-x-1 group-hover:opacity-100">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="relative px-5 py-16 sm:px-6 lg:px-10 lg:py-24">
          <div class="relative mx-auto max-w-5xl overflow-hidden border border-[#d9ad55]/50 bg-gradient-to-r from-[#100618] via-[#24102f] to-[#100618] px-7 py-12 text-center sm:px-12 sm:py-16">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(109,25,201,.18),transparent_65%)]"></div>
            <div class="relative">
              <div class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[#d9ad55] bg-[#160722] text-2xl text-[#ffe8a6]">✦</div>
              <p class="mt-6 text-[9px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">THE MELAGRAM PHILOSOPHY</p>
              <h2 class="display mt-3 text-3xl leading-tight text-[#ffe8a6] sm:text-5xl">Create. Connect. Be Seen.</h2>
              <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-white/45 sm:text-base">Your creativity deserves more than a profile buried in a feed. Build relationships, find your people, share your work, and let the community discover what you bring to the table.</p>
              <a href="/creators/vault" class="mt-8 inline-flex rounded-xl border border-[#d9ad55] bg-[#160722] px-7 py-3.5 text-[10px] font-bold uppercase tracking-[.2em] text-[#ffe8a6] transition hover:bg-[#d9ad55] hover:text-black">Discover Creators</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="border-t border-[#d9ad55]/20 bg-[#050208] px-5 py-10 lg:px-10">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 text-center sm:flex-row sm:text-left">
          <div>
            <p class="display text-lg tracking-[.2em] text-[#ffe8a6]">MELAGRAM</p>
            <p class="mt-1 text-[10px] uppercase tracking-[.3em] text-white/35">Connect. Network. Create. Build Community.</p>
          </div>
          <div class="flex flex-wrap justify-center gap-5 text-[9px] font-bold uppercase tracking-[.18em] text-white/35">
            <a href="/creators" class="transition hover:text-[#ffe8a6]">Creators</a>
            <a href="/creators/vault" class="transition hover:text-[#ffe8a6]">Vault</a>
            <a href="/gossip" class="transition hover:text-[#ffe8a6]">Gossip</a>
            <a href="/about" class="transition hover:text-[#ffe8a6]">About</a>
          </div>
          <p class="text-xs text-white/30">© 2026 Melagram. All rights reserved.</p>
        </div>
      </footer>

      <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>
    </div>
  </body>
</html>
