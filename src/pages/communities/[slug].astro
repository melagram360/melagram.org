---
import "../../styles/global.css";

export function getStaticPaths() {
  const communities = [
    {
      slug: "creative-minds",
      icon: "🎨",
      name: "Creative Minds",
      category: "Creativity",
      members: "12.4K",
      description:
        "A space for artists, designers, writers, musicians, and creative people to share ideas and inspire each other."
    },
    {
      slug: "music-lounge",
      icon: "🎵",
      name: "Music Lounge",
      category: "Music",
      members: "9.8K",
      description:
        "Talk music, discover new sounds, share your work, and connect with people who live and breathe music."
    },
    {
      slug: "movie-tv-talk",
      icon: "🎬",
      name: "Movie & TV Talk",
      category: "Entertainment",
      members: "8.6K",
      description:
        "Your spot for movie nights, television debates, reviews, recommendations, and everything on screen."
    },
    {
      slug: "food-flavor",
      icon: "🍳",
      name: "Food & Flavor",
      category: "Lifestyle",
      members: "7.2K",
      description:
        "Recipes, cooking experiments, restaurant finds, food stories, and people who simply love to eat."
    },
    {
      slug: "travel-circle",
      icon: "✈️",
      name: "Travel Circle",
      category: "Travel",
      members: "6.9K",
      description:
        "Share destinations, travel stories, tips, dream trips, and unforgettable experiences from around the world."
    },
    {
      slug: "real-talk",
      icon: "💬",
      name: "Real Talk",
      category: "Conversation",
      members: "15.1K",
      description:
        "Open conversations about life, culture, relationships, experiences, and the things people really want to discuss."
    }
  ];

  return communities.map((community) => ({
    params: {
      slug: community.slug
    },
    props: {
      community
    }
  }));
}

const { community } = Astro.props;

export const prerender = true;

const posts = [
  {
    author: "Melagram Community",
    initials: "M",
    time: "Pinned",
    badge: "Community Admin",
    title: `Welcome to ${community.name}!`,
    content:
      "This is your space to connect, share ideas, start conversations, and meet people who share your interests. Introduce yourself and let the community know what brought you here!",
    likes: 248,
    comments: 42,
    pinned: true
  },
  {
    author: "Jordan Ellis",
    initials: "JE",
    time: "18 min ago",
    badge: "",
    title: "",
    content:
      "What is everybody working on this week? Drop your projects, ideas, recommendations, or just tell us what you've been into lately.",
    likes: 86,
    comments: 19,
    pinned: false
  },
  {
    author: "Taylor Morgan",
    initials: "TM",
    time: "1 hr ago",
    badge: "",
    title: "",
    content:
      "Sometimes the best conversations happen when somebody simply asks a good question. So here's mine: what is one thing you wish more people in this community talked about?",
    likes: 64,
    comments: 27,
    pinned: false
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`${community.name} community on Melagram.`}
    />
    <title>{community.name} — Melagram</title>
  </head>

  <body>
    <div class="min-h-screen overflow-hidden">

      <!-- TOP GOLD FRAME -->
      <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>

      <!-- NAV -->
      <header class="relative z-30 border-b border-[#d9ad55]/30 bg-[#07030d]/95 backdrop-blur">

        <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">

          <a
            href="/"
            class="flex items-center gap-3"
            aria-label="Melagram Home"
          >
            <div class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#1a0827] text-[#ffe8a6] shadow-[0_0_18px_rgba(109,25,201,.4)]">
              M
            </div>

            <span class="display hidden text-lg tracking-[.18em] text-[#ffe8a6] sm:block">
              MELAGRAM
            </span>
          </a>

          <div class="hidden items-center gap-7 text-[11px] font-semibold uppercase tracking-[.22em] text-white/75 md:flex">

            <a class="nav-link" href="/">Home</a>

            <a class="nav-link" href="/discover">Discover</a>

            <a class="nav-link text-[#d9ad55]" href="/communities">
              Communities
            </a>

            <a class="nav-link" href="/#creators">
              Creators
            </a>

            <a class="nav-link" href="/about">
              About
            </a>

          </div>

          <div class="flex items-center gap-3">

            <a
              href="#"
              class="hidden rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white/80 sm:block"
            >
              Log In
            </a>

            <a
              href="/#join"
              class="cta rounded-full px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white"
            >
              Join Melagram
            </a>

          </div>

        </nav>

      </header>

      <!-- COMMUNITY HEADER -->
      <main>

        <section class="relative overflow-hidden border-b border-[#d9ad55]/20">

          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(109,25,201,.4),transparent_58%)]"></div>

          <div class="absolute -left-40 top-10 h-80 w-80 rounded-full bg-[#6d19c9]/10 blur-3xl"></div>

          <div class="absolute -right-40 top-10 h-80 w-80 rounded-full bg-[#d9ad55]/5 blur-3xl"></div>

          <div class="relative mx-auto max-w-7xl px-5 py-10 lg:px-10 lg:py-14">

            <a
              href="/communities"
              class="mb-8 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.2em] text-white/40 transition hover:text-[#ffe8a6]"
            >
              ← Back to Communities
            </a>

            <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">

              <div>

                <div class="mb-5 flex flex-wrap items-center gap-3">

                  <span class="rounded-full border border-[#d9ad55]/50 bg-[#160722] px-4 py-2 text-[9px] font-bold uppercase tracking-[.2em] text-[#d9ad55]">
                    {community.category}
                  </span>

                  <span class="text-[9px] font-semibold uppercase tracking-[.3em] text-white/30">
                    PUBLIC COMMUNITY
                  </span>

                </div>

                <div class="flex items-center gap-5">

                  <div class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl border-2 border-[#d9ad55]/70 bg-[#160722] text-4xl shadow-[0_0_35px_rgba(109,25,201,.28)] sm:h-24 sm:w-24 sm:text-5xl">
                    {community.icon}
                  </div>

                  <div>

                    <p class="text-[10px] font-bold uppercase tracking-[.45em] text-[#d9ad55]">
                      COMMUNITY
                    </p>

                    <h1 class="display mt-2 text-4xl leading-tight text-[#fff4d4] sm:text-6xl">
                      {community.name}
                    </h1>

                  </div>

                </div>

                <p class="mt-6 max-w-3xl text-sm leading-7 text-white/50 sm:text-base">
                  {community.description}
                </p>

                <div class="mt-6 flex flex-wrap items-center gap-5 text-[10px] font-semibold uppercase tracking-[.18em]">

                  <span class="text-[#ffe8a6]">
                    {community.members} members
                  </span>

                  <span class="h-1 w-1 rounded-full bg-[#d9ad55]"></span>

                  <span class="text-white/30">
                    Community since 2026
                  </span>

                </div>

              </div>

              <button
                class="cta w-full rounded-xl px-8 py-4 text-sm font-bold uppercase tracking-[.16em] text-white sm:w-auto"
              >
                Join Community
              </button>

            </div>

          </div>

        </section>

        <!-- COMMUNITY NAVIGATION -->
        <section class="sticky top-0 z-20 border-b border-[#d9ad55]/20 bg-[#07030d]/95 backdrop-blur">

          <div class="mx-auto flex max-w-7xl gap-8 overflow-x-auto px-5 lg:px-10">

            <a
              href="#feed"
              class="border-b-2 border-[#d9ad55] py-4 text-[10px] font-bold uppercase tracking-[.2em] text-[#ffe8a6]"
            >
              Home
            </a>

            <a
              href="#posts"
              class="py-4 text-[10px] font-bold uppercase tracking-[.2em] text-white/40 transition hover:text-[#ffe8a6]"
            >
              Posts
            </a>

            <a
              href="#members"
              class="py-4 text-[10px] font-bold uppercase tracking-[.2em] text-white/40 transition hover:text-[#ffe8a6]"
            >
              Members
            </a>

            <a
              href="about"
              class="py-4 text-[10px] font-bold uppercase tracking-[.2em] text-white/40 transition hover:text-[#ffe8a6]"
            >
              About
            </a>

          </div>

        </section>

        <!-- COMMUNITY FEED -->
        <section id="feed" class="px-5 py-10 lg:px-10 lg:py-14">

          <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">

            <!-- MAIN COLUMN -->
            <div class="space-y-6">

              <!-- CREATE POST -->
              <div class="luxury-panel gold-border rounded-2xl p-5 sm:p-6">

                <div class="flex items-center gap-4">

                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-[#d9ad55]/50 bg-[#160722] text-sm font-bold text-[#ffe8a6]">
                    M
                  </div>

                  <button
                    class="w-full rounded-xl border border-white/10 bg-black/25 px-5 py-4 text-left text-sm text-white/30 transition hover:border-[#d9ad55]/40 hover:bg-black/40"
                  >
                    What's happening in {community.name}?
                  </button>

                </div>

                <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-[#d9ad55]/10 pt-5">

                  <div class="flex flex-wrap gap-5">

                    <button class="text-[10px] font-bold uppercase tracking-wider text-white/40 transition hover:text-[#ffe8a6]">
                      📷 Photo
                    </button>

                    <button class="text-[10px] font-bold uppercase tracking-wider text-white/40 transition hover:text-[#ffe8a6]">
                      🎥 Video
                    </button>

                    <button class="text-[10px] font-bold uppercase tracking-wider text-white/40 transition hover:text-[#ffe8a6]">
                      ✨ Create
                    </button>

                  </div>

                  <button
                    class="rounded-lg border border-[#d9ad55]/60 px-5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#d9ad55] hover:text-black"
                  >
                    Create Post
                  </button>

                </div>

              </div>

              <!-- FEED LABEL -->
              <div id="posts" class="flex items-end justify-between">

                <div>

                  <p class="text-[10px] font-bold uppercase tracking-[.45em] text-[#d9ad55]">
                    Community Feed
                  </p>

                  <h2 class="display mt-2 text-3xl text-[#fff4d4]">
                    What's happening
                  </h2>

                </div>

                <button class="hidden text-[10px] font-bold uppercase tracking-wider text-white/35 transition hover:text-[#ffe8a6] sm:block">
                  Latest ▾
                </button>

              </div>

              <!-- POSTS -->
              {posts.map((post) => (

                <article class="luxury-panel gold-border rounded-2xl p-6">

                  <div class="flex items-start justify-between gap-4">

                    <div class="flex items-center gap-4">

                      <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#160722] text-xs font-bold text-[#ffe8a6]">
                        {post.initials}
                      </div>

                      <div>

                        <div class="flex flex-wrap items-center gap-2">

                          <h3 class="text-sm font-semibold text-white">
                            {post.author}
                          </h3>

                          {post.pinned && (
                            <span class="rounded-full border border-[#d9ad55]/30 px-2 py-1 text-[8px] font-bold uppercase tracking-wider text-[#d9ad55]">
                              📌 Pinned
                            </span>
                          )}

                          {post.badge && (
                            <span class="text-[9px] uppercase tracking-wider text-white/25">
                              {post.badge}
                            </span>
                          )}

                        </div>

                        <p class="mt-1 text-[10px] text-white/25">
                          {post.time}
                        </p>

                      </div>

                    </div>

                    <button class="text-lg text-white/25 hover:text-[#ffe8a6]">
                      •••
                    </button>

                  </div>

                  {post.title && (
                    <h3 class="display mt-6 text-xl text-[#ffe8a6]">
                      {post.title}
                    </h3>
                  )}

                  <p class="mt-4 text-sm leading-7 text-white/55">
                    {post.content}
                  </p>

                  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-[#d9ad55]/10 pt-5">

                    <div class="flex gap-6">

                      <button class="text-[10px] font-bold uppercase tracking-wider text-white/35 transition hover:text-[#ffe8a6]">
                        ♡ {post.likes} Likes
                      </button>

                      <button class="text-[10px] font-bold uppercase tracking-wider text-white/35 transition hover:text-[#ffe8a6]">
                        ◯ {post.comments} Comments
                      </button>

                    </div>

                    <button class="text-[10px] font-bold uppercase tracking-wider text-white/35 transition hover:text-[#ffe8a6]">
                      ↗ Share
                    </button>

                  </div>

                </article>

              ))}

              <!-- MORE POSTS -->
              <div class="rounded-2xl border border-[#d9ad55]/15 bg-[#08040d] px-6 py-12 text-center">

                <p class="text-[10px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">
                  More to Come
                </p>

                <h2 class="display mt-3 text-2xl text-[#fff4d4]">
                  Your community is just getting started.
                </h2>

                <p class="mx-auto mt-3 max-w-lg text-sm leading-7 text-white/35">
                  As Melagram grows, this feed will become a living stream of
                  conversations, photos, videos, ideas, and connections.
                </p>

              </div>

            </div>

            <!-- SIDEBAR -->
            <aside class="space-y-6">

              <!-- ABOUT -->
              <div id="about" class="luxury-panel gold-border rounded-2xl p-6">

                <p class="text-[10px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">
                  About This Community
                </p>

                <h2 class="display mt-3 text-2xl text-[#ffe8a6]">
                  {community.name}
                </h2>

                <p class="mt-4 text-sm leading-7 text-white/45">
                  {community.description}
                </p>

                <div class="mt-6 space-y-4 border-t border-[#d9ad55]/10 pt-6">

                  <div class="flex items-center justify-between">

                    <span class="text-[10px] uppercase tracking-wider text-white/30">
                      Members
                    </span>

                    <span class="text-sm font-semibold text-[#ffe8a6]">
                      {community.members}
                    </span>

                  </div>

                  <div class="flex items-center justify-between">

                    <span class="text-[10px] uppercase tracking-wider text-white/30">
                      Category
                    </span>

                    <span class="text-sm font-semibold text-[#ffe8a6]">
                      {community.category}
                    </span>

                  </div>

                  <div class="flex items-center justify-between">

                    <span class="text-[10px] uppercase tracking-wider text-white/30">
                      Privacy
                    </span>

                    <span class="text-sm font-semibold text-[#ffe8a6]">
                      Public
                    </span>

                  </div>

                </div>

              </div>

              <!-- MEMBERS -->
              <div id="members" class="luxury-panel gold-border rounded-2xl p-6">

                <div class="flex items-center justify-between">

                  <p class="text-[10px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">
                    Members
                  </p>

                  <span class="text-[9px] uppercase tracking-wider text-white/25">
                    {community.members}
                  </span>

                </div>

                <div class="mt-6 flex items-center">

                  <div class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#160722] text-[10px] text-[#ffe8a6]">
                    JD
                  </div>

                  <div class="-ml-3 grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#24102f] text-[10px] text-[#ffe8a6]">
                    TM
                  </div>

                  <div class="-ml-3 grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#160722] text-[10px] text-[#ffe8a6]">
                    AR
                  </div>

                  <div class="-ml-3 grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#24102f] text-[10px] text-[#ffe8a6]">
                    KS
                  </div>

                  <div class="-ml-3 grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/60 bg-[#d9ad55] text-[10px] font-bold text-black">
                    +
                  </div>

                </div>

                <p class="mt-5 text-xs leading-6 text-white/35">
                  Meet people, join conversations, and become part of the
                  community.
                </p>

              </div>

              <!-- COMMUNITY RULES -->
              <div class="luxury-panel gold-border rounded-2xl p-6">

                <p class="text-[10px] font-bold uppercase tracking-[.4em] text-[#d9ad55]">
                  Community Rules
                </p>

                <div class="mt-5 space-y-5">

                  <div class="flex gap-3">

                    <span class="text-[10px] text-[#d9ad55]">
                      01
                    </span>

                    <p class="text-xs leading-6 text-white/45">
                      Respect the people you're talking to.
                    </p>

                  </div>

                  <div class="flex gap-3">

                    <span class="text-[10px] text-[#d9ad55]">
                      02
                    </span>

                    <p class="text-xs leading-6 text-white/45">
                      Keep conversations relevant and constructive.
                    </p>

                  </div>

                  <div class="flex gap-3">

                    <span class="text-[10px] text-[#d9ad55]">
                      03
                    </span>

                    <p class="text-xs leading-6 text-white/45">
                      No harassment, spam, or malicious content.
                    </p>

                  </div>

                </div>

              </div>

              <!-- BROWSE -->
              <a
                href="/communities"
                class="block rounded-2xl border border-[#d9ad55]/30 bg-[#0a050f] p-6 text-center transition hover:border-[#d9ad55]/70 hover:bg-[#12071b]"
              >

                <p class="text-[10px] font-bold uppercase tracking-[.25em] text-[#d9ad55]">
                  Explore More
                </p>

                <p class="display mt-2 text-xl text-[#ffe8a6]">
                  Browse Communities
                </p>

                <p class="mt-2 text-xs text-white/30">
                  Find your next conversation.
                </p>

              </a>

            </aside>

          </div>

        </section>

      </main>

      <!-- FOOTER -->
      <footer class="border-t border-[#d9ad55]/20 bg-[#050208] px-5 py-10 lg:px-10">

        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 text-center sm:flex-row sm:text-left">

          <div>

            <p class="display text-lg tracking-[.2em] text-[#ffe8a6]">
              MELAGRAM
            </p>

            <p class="mt-1 text-[10px] uppercase tracking-[.3em] text-white/35">
              Connect. Network. Create. Build Community.
            </p>

          </div>

          <p class="text-xs text-white/30">
            © 2026 Melagram. All rights reserved.
          </p>

        </div>

      </footer>

      <!-- BOTTOM GOLD FRAME -->
      <div class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"></div>

    </div>
  </body>
</html>