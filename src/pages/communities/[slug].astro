---
import "../../styles/global.css";
import { actions } from "astro:actions";
import { createClient } from "../../lib/supabase";

/*
 * This is a dynamic SSR community page.
 * We intentionally disable prerendering so Astro can
 * resolve the /communities/[slug] route at request time.
 */
export const prerender = false;

const communityList = {
  "creative-minds": {
    icon: "🎨",
    name: "Creative Minds",
    category: "Creativity",
    members: "12.4K members",
    description:
      "A space for artists, designers, writers, musicians, and creative people to share ideas and inspire each other.",
  },

  "music-lounge": {
    icon: "🎵",
    name: "Music Lounge",
    category: "Music",
    members: "9.8K members",
    description:
      "Talk music, discover new sounds, share your work, and connect with people who live and breathe music.",
  },

  "movie-tv-talk": {
    icon: "🎬",
    name: "Movie & TV Talk",
    category: "Entertainment",
    members: "8.6K members",
    description:
      "Your spot for movie nights, television debates, reviews, recommendations, and everything on screen.",
  },

  "food-flavor": {
    icon: "🍳",
    name: "Food & Flavor",
    category: "Lifestyle",
    members: "7.2K members",
    description:
      "Recipes, cooking experiments, restaurant finds, food stories, and people who simply love to eat.",
  },

  "travel-circle": {
    icon: "✈️",
    name: "Travel Circle",
    category: "Travel",
    members: "6.9K members",
    description:
      "Share destinations, travel stories, tips, dream trips, and unforgettable experiences from around the world.",
  },

  "real-talk": {
    icon: "💬",
    name: "Real Talk",
    category: "Conversation",
    members: "15.1K members",
    description:
      "Open conversations about life, culture, relationships, experiences, and the things people really want to discuss.",
  },
} as const;

type CommunitySlug = keyof typeof communityList;

const slug = Astro.params.slug as CommunitySlug | undefined;

const community =
  slug && communityList[slug]
    ? communityList[slug]
    : null;

if (!community || !slug) {
  return Astro.redirect("/communities");
}

/* --------------------------------
   SUPABASE
--------------------------------- */

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
  env: Astro.locals.runtime.env,
});

/* --------------------------------
   CURRENT USER
--------------------------------- */

const {
  data: { user },
} = await supabase.auth.getUser();

const displayName =
  user?.user_metadata?.full_name ||
  user?.user_metadata?.username ||
  user?.email?.split("@")[0] ||
  "Member";

/* --------------------------------
   COMMUNITY MEMBERSHIP
--------------------------------- */

const {
  data: communityRecord,
  error: communityRecordError,
} = await supabase
  .from("communities")
  .select("id")
  .eq("slug", slug)
  .maybeSingle();

let communityId: string | null = null;
let isCommunityMember = false;

if (!communityRecordError && communityRecord) {
  communityId = communityRecord.id;
}

if (user && communityId) {
  const {
    data: membership,
  } = await supabase
    .from("community_members")
    .select("community_id")
    .eq("community_id", communityId)
    .eq("user_id", user.id)
    .maybeSingle();

  isCommunityMember = !!membership;
}

/* --------------------------------
   COMMUNITY POSTS
--------------------------------- */

const {
  data: posts,
  error: postsError,
} = await supabase
  .from("posts")
  .select(
    "id, user_id, content, created_at, community_slug"
  )
  .eq("community_slug", slug)
  .order("created_at", {
    ascending: false,
  });

let communityPosts: any[] = [];

if (!postsError && posts && posts.length > 0) {
  const postIds = posts.map(
    (post) => post.id
  );

  const userIds = [
    ...new Set(
      posts.map(
        (post) => post.user_id
      )
    ),
  ];

  /* --------------------------------
     POST PROFILES
  --------------------------------- */

  const {
    data: profiles,
  } = user
    ? await supabase
        .from("profiles")
        .select(
          "id, username, full_name, avatar_url"
        )
        .in("id", userIds)
    : {
        data: [],
      };

  const profileMap =
    new Map(
      (profiles ?? []).map(
        (profile) => [
          profile.id,
          profile,
        ]
      )
    );

  /* --------------------------------
     LIKES
  --------------------------------- */

  let likes: any[] = [];

  if (user) {
    const {
      data: likeData,
    } = await supabase
      .from("post_likes")
      .select(
        "post_id, user_id"
      )
      .in(
        "post_id",
        postIds
      );

    likes = likeData ?? [];
  }

  const likeCountMap =
    new Map<string, number>();

  const likedByCurrentUser =
    new Set<string>();

  for (const like of likes) {
    likeCountMap.set(
      like.post_id,
      (likeCountMap.get(
        like.post_id
      ) ?? 0) + 1
    );

    if (
      user &&
      like.user_id === user.id
    ) {
      likedByCurrentUser.add(
        like.post_id
      );
    }
  }

  /* --------------------------------
     COMMENTS
  --------------------------------- */

  let comments: any[] = [];

  if (user) {
    const {
      data: commentData,
    } = await supabase
      .from("post_comments")
      .select(
        "id, post_id, user_id, content, created_at"
      )
      .in(
        "post_id",
        postIds
      )
      .order(
        "created_at",
        {
          ascending: true,
        }
      );

    comments = commentData ?? [];
  }

  const commentUserIds =
    comments.map(
      (comment) =>
        comment.user_id
    );

  const allProfileIds = [
    ...new Set([
      ...userIds,
      ...commentUserIds,
    ]),
  ];

  let allProfiles: any[] = [];

  if (
    user &&
    allProfileIds.length > 0
  ) {
    const {
      data: profileData,
    } = await supabase
      .from("profiles")
      .select(
        "id, username, full_name, avatar_url"
      )
      .in(
        "id",
        allProfileIds
      );

    allProfiles =
      profileData ?? [];
  }

  const allProfileMap =
    new Map(
      allProfiles.map(
        (profile) => [
          profile.id,
          profile,
        ]
      )
    );

  const commentsByPost =
    new Map<string, any[]>();

  for (const comment of comments) {
    const existing =
      commentsByPost.get(
        comment.post_id
      ) ?? [];

    existing.push({
      ...comment,
      profile:
        allProfileMap.get(
          comment.user_id
        ) ?? null,
    });

    commentsByPost.set(
      comment.post_id,
      existing
    );
  }

  /* --------------------------------
     BUILD COMMUNITY FEED
  --------------------------------- */

  communityPosts =
    posts.map((post) => ({
      ...post,

      profile:
        allProfileMap.get(
          post.user_id
        ) ??
        profileMap.get(
          post.user_id
        ) ??
        null,

      likeCount:
        likeCountMap.get(
          post.id
        ) ?? 0,

      likedByCurrentUser:
        likedByCurrentUser.has(
          post.id
        ),

      commentCount:
        commentsByPost.get(
          post.id
        )?.length ?? 0,

      comments:
        commentsByPost.get(
          post.id
        ) ?? [],
    }));
}
---

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content={`${community.name} community on Melagram.`}
    />

    <title>
      {community.name} — Melagram
    </title>

  </head>


  <body>

    <div
      class="min-h-screen overflow-hidden bg-[#050208] text-[#fff7e5]"
    >

      <!-- TOP GOLD FRAME -->

      <div
        class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"
      ></div>


      <!-- NAV -->

      <header
        class="relative z-20 border-b border-[#d9ad55]/30 bg-[#07030d]/90 backdrop-blur"
      >

        <nav
          class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10"
        >

          <a
            href="/"
            class="flex items-center gap-3"
            aria-label="Melagram Home"
          >

            <div
              class="grid h-10 w-10 place-items-center rounded-full border border-[#d9ad55]/70 bg-[#1a0827] text-[#ffe8a6] shadow-[0_0_18px_rgba(109,25,201,.4)]"
            >
              M
            </div>

            <span
              class="display hidden text-lg tracking-[.18em] text-[#ffe8a6] sm:block"
            >
              MELAGRAM
            </span>

          </a>


          <div
            class="hidden items-center gap-7 text-[11px] font-semibold uppercase tracking-[.22em] text-white/75 md:flex"
          >

            <a
              class="nav-link"
              href="/"
            >
              Home
            </a>

            <a
              class="nav-link"
              href="/discover"
            >
              Discover
            </a>

            <a
              class="nav-link text-[#d9ad55]"
              href="/communities"
            >
              Communities
            </a>

            <a
              class="nav-link"
              href="/#creators"
            >
              Creators
            </a>

            <a
              class="nav-link"
              href="/#about"
            >
              About
            </a>

          </div>


          {user ? (

            <div
              class="flex items-center gap-3"
            >

              <a
                href="/profile"
                class="hidden rounded-full border border-[#d9ad55]/40 px-4 py-2 text-xs text-[#ffe8a6] transition hover:bg-[#d9ad55]/10 sm:block"
              >
                {displayName}
              </a>

              <a
                href="/dashboard"
                class="cta rounded-full px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white"
              >
                Dashboard
              </a>

            </div>

          ) : (

            <a
              href="/join"
              class="cta rounded-full px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white"
            >
              Join Melagram
            </a>

          )}

        </nav>

      </header>


      <main>

        <!-- COMMUNITY HERO -->

        <section
          class="relative px-5 pb-16 pt-16 sm:pt-20 lg:px-10"
        >

          <div
            class="absolute inset-x-0 top-0 h-[32rem] bg-[radial-gradient(circle_at_center,rgba(109,25,201,.30),transparent_65%)]"
          ></div>


          <div
            class="relative mx-auto max-w-5xl text-center"
          >

            <div
              class="mb-8 flex items-center justify-center gap-4"
            >

              <div
                class="gold-line w-20 sm:w-40"
              ></div>

            </div>


            <div
              class="mx-auto grid h-24 w-24 place-items-center rounded-full border-2 border-[#d9ad55]/70 bg-[#160722] text-5xl shadow-[0_0_40px_rgba(109,25,201,.35)]"
            >
              {community.icon}
            </div>


            <p
              class="mt-8 text-[10px] font-bold uppercase tracking-[.5em] text-[#d9ad55]"
            >
              COMMUNITY
            </p>


            <h1
              class="display mt-4 text-5xl leading-tight text-[#fff4d4] sm:text-7xl"
            >
              {community.name}
            </h1>


            <p
              class="mx-auto mt-6 max-w-2xl text-base leading-8 text-white/55 sm:text-lg"
            >
              {community.description}
            </p>


            <div
              class="mt-8 flex flex-wrap items-center justify-center gap-4"
            >

              <span
                class="rounded-full border border-[#d9ad55]/30 bg-[#160722]/60 px-5 py-2.5 text-xs uppercase tracking-wider text-[#ffe8a6]"
              >
                {community.members}
              </span>

              <span
                class="rounded-full border border-[#d9ad55]/30 bg-[#160722]/60 px-5 py-2.5 text-xs uppercase tracking-wider text-white/55"
              >
                {community.category}
              </span>

            </div>


            {user ? (

              <button
                type="button"
                id="community-join-btn"
                data-community-id={communityId ?? ""}
                data-member={
                  isCommunityMember
                    ? "true"
                    : "false"
                }
                class="cta mt-8 rounded-xl px-9 py-4 text-sm font-bold uppercase tracking-wider text-white"
              >
                {isCommunityMember
                  ? "Leave Community"
                  : "Join Community"}
              </button>

            ) : (

              <a
                href="/login"
                class="cta mt-8 inline-flex rounded-xl px-9 py-4 text-sm font-bold uppercase tracking-wider text-white"
              >
                Sign In to Join
              </a>

            )}

          </div>

        </section>


        <!-- COMMUNITY FEED -->

        <section
          class="border-y border-[#d9ad55]/20 bg-black/30 px-5 py-14 lg:px-10"
        >

          <div
            class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[1fr_340px]"
          >

            <!-- FEED -->

            <div
              class="luxury-panel gold-border rounded-2xl p-7 sm:p-9"
            >

              <div
                class="flex flex-col gap-4 border-b border-[#d9ad55]/20 pb-5 sm:flex-row sm:items-end sm:justify-between"
              >

                <div>

                  <p
                    class="text-[10px] font-bold uppercase tracking-[.4em] text-[#d9ad55]"
                  >
                    Community Feed
                  </p>

                  <h2
                    class="display mt-2 text-3xl text-[#fff4d4]"
                  >
                    What's happening?
                  </h2>

                  <p
                    class="mt-2 text-sm text-white/40"
                  >
                    Conversations happening inside {community.name}.
                  </p>

                </div>

                {user && (

                  <button
                    type="button"
                    id="community-post-focus"
                    class="rounded-full border border-[#d9ad55]/40 px-4 py-2 text-[10px] font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:border-[#d9ad55] hover:bg-[#d9ad55]/10"
                  >
                    + New Post
                  </button>

                )}

              </div>


              <!-- CREATE COMMUNITY POST -->

              {user && (

                <form
                  id="community-post-form"
                  class="mt-7 rounded-2xl border border-[#d9ad55]/20 bg-black/20 p-5"
                >

                  <div
                    class="mb-3 flex items-center gap-2"
                  >

                    <span
                      class="text-xs uppercase tracking-[.2em] text-[#d9ad55]"
                    >
                      Post to {community.name}
                    </span>

                  </div>


                  <textarea
                    id="community-post-content"
                    name="content"
                    maxlength="2000"
                    rows="4"
                    required
                    placeholder={`What's on your mind about ${community.name}?`}
                    class="w-full resize-none rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-sm leading-7 text-white outline-none transition placeholder:text-white/25 focus:border-[#d9ad55]/50"
                  ></textarea>


                  <div
                    class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
                  >

                    <span
                      class="text-[10px] uppercase tracking-wider text-white/25"
                    >
                      2,000 characters maximum
                    </span>


                    <button
                      type="submit"
                      id="community-post-submit"
                      class="cta rounded-xl px-6 py-3 text-xs font-bold uppercase tracking-wider text-white"
                    >
                      Publish Post
                    </button>

                  </div>


                  <p
                    id="community-post-message"
                    class="mt-3 hidden text-xs"
                  ></p>

                </form>

              )}


              <!-- POSTS -->

              {postsError ? (

                <div
                  class="mt-8 rounded-xl border border-red-400/20 bg-red-950/10 px-6 py-10 text-center"
                >

                  <div
                    class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-red-300/20 bg-red-950/20 text-2xl"
                  >
                    !
                  </div>

                  <h3
                    class="display mt-5 text-2xl text-[#ffe8a6]"
                  >
                    The community feed couldn't load.
                  </h3>

                  <p
                    class="mx-auto mt-3 max-w-lg text-sm leading-7 text-white/40"
                  >
                    Please refresh the page and try again.
                  </p>

                </div>

              ) : communityPosts.length === 0 ? (

                <div
                  class="mt-8 rounded-xl border border-dashed border-[#d9ad55]/25 bg-black/20 px-6 py-12 text-center"
                >

                  <div
                    class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#160722] text-2xl"
                  >
                    💬
                  </div>

                  <h3
                    class="display mt-5 text-2xl text-[#ffe8a6]"
                  >
                    The conversation starts here.
                  </h3>

                  <p
                    class="mx-auto mt-3 max-w-lg text-sm leading-7 text-white/40"
                  >
                    There aren't any posts in this community yet.
                    {user
                      ? " Be the first person to start the conversation."
                      : " Sign in to become part of the conversation."}
                  </p>

                  {!user && (

                    <a
                      href="/login"
                      class="cta mt-6 inline-flex rounded-xl px-7 py-3 text-xs font-bold uppercase tracking-wider text-white"
                    >
                      Sign In
                    </a>

                  )}

                </div>

              ) : (

                <div
                  class="mt-8 space-y-5"
                >

                  {communityPosts.map(
                    (post) => {

                      const profile =
                        post.profile;

                      const postName =
                        profile?.full_name ||
                        profile?.username ||
                        "Melagram Member";

                      const username =
                        profile?.username
                          ? `@${profile.username}`
                          : "";

                      const avatarUrl =
                        profile?.avatar_url;

                      const postDate =
                        post.created_at
                          ? new Date(
                              post.created_at
                            ).toLocaleString(
                              "en-US",
                              {
                                month:
                                  "short",
                                day:
                                  "numeric",
                                year:
                                  "numeric",
                                hour:
                                  "numeric",
                                minute:
                                  "2-digit",
                              }
                            )
                          : "";

                      return (

                        <article
                          id={`post-${post.id}`}
                          class="community-post gold-border rounded-2xl bg-black/20 p-5 transition hover:border-[#d9ad55]/40 sm:p-6"
                          data-post-id={post.id}
                        >

                          <!-- AUTHOR -->

                          <div
                            class="flex items-start gap-3"
                          >

                            {avatarUrl ? (

                              <img
                                src={avatarUrl}
                                alt={postName}
                                class="h-11 w-11 shrink-0 rounded-full border border-[#d9ad55]/40 object-cover"
                              />

                            ) : (

                              <div
                                class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-[#d9ad55]/40 bg-[#160722] text-sm font-semibold text-[#ffe8a6]"
                              >
                                {postName
                                  .charAt(
                                    0
                                  )
                                  .toUpperCase()}
                              </div>

                            )}


                            <div
                              class="min-w-0 flex-1"
                            >

                              <div
                                class="flex flex-wrap items-baseline gap-x-2 gap-y-1"
                              >

                                <span
                                  class="font-semibold text-[#ffe8a6]"
                                >
                                  {postName}
                                </span>

                                {username && (

                                  <span
                                    class="text-xs text-white/35"
                                  >
                                    {username}
                                  </span>

                                )}

                              </div>


                              {postDate && (

                                <p
                                  class="mt-1 text-[11px] text-white/30"
                                >
                                  {postDate}
                                </p>

                              )}

                            </div>

                          </div>


                          <!-- CONTENT -->

                          <div
                            class="mt-4 border-t border-white/10 pt-4"
                          >

                            <p
                              class="whitespace-pre-wrap text-sm leading-7 text-white/75"
                            >
                              {post.content}
                            </p>

                          </div>


                          <!-- ENGAGEMENT -->

                          {user && (

                            <div
                              class="mt-4 flex flex-wrap items-center gap-2 border-t border-white/10 pt-3"
                            >

                              <!-- LIKE -->

                              <button
                                type="button"
                                class:list={[
                                  "community-like-btn",
                                  "inline-flex",
                                  "items-center",
                                  "gap-2",
                                  "rounded-full",
                                  "px-3",
                                  "py-2",
                                  "text-[10px]",
                                  "uppercase",
                                  "tracking-[0.12em]",
                                  "transition",
                                  post.likedByCurrentUser
                                    ? "bg-[#6d19c9]/25 text-[#ffe8a6]"
                                    : "text-white/40 hover:bg-[#6d19c9]/15 hover:text-[#ffe8a6]",
                                ]}
                                data-post-id={
                                  post.id
                                }
                                aria-pressed={
                                  post.likedByCurrentUser
                                    ? "true"
                                    : "false"
                                }
                              >

                                <span
                                  class="community-like-icon"
                                >
                                  {post.likedByCurrentUser
                                    ? "♥"
                                    : "♡"}
                                </span>

                                <span
                                  class="community-like-label"
                                >
                                  {post.likedByCurrentUser
                                    ? "Liked"
                                    : "Like"}
                                </span>

                                <span
                                  class="community-like-count"
                                >
                                  {post.likeCount}
                                </span>

                              </button>


                              <!-- COMMENT -->

                              <button
                                type="button"
                                class="community-comment-toggle inline-flex items-center gap-2 rounded-full px-3 py-2 text-[10px] uppercase tracking-[0.12em] text-white/40 transition hover:bg-[#6d19c9]/15 hover:text-[#ffe8a6]"
                                data-post-id={
                                  post.id
                                }
                              >

                                <span>
                                  ○
                                </span>

                                <span>
                                  Comment
                                </span>

                                <span
                                  class="community-comment-count"
                                >
                                  {post.commentCount}
                                </span>

                              </button>


                              <!-- SHARE -->

                              <button
                                type="button"
                                class="community-share-btn inline-flex items-center gap-2 rounded-full px-3 py-2 text-[10px] uppercase tracking-[0.12em] text-white/40 transition hover:bg-[#6d19c9]/15 hover:text-[#ffe8a6]"
                                data-post-id={
                                  post.id
                                }
                              >

                                <span
                                  class="community-share-icon"
                                >
                                  ↗
                                </span>

                                <span
                                  class="community-share-label"
                                >
                                  Share
                                </span>

                              </button>

                            </div>

                          )}


                          <!-- COMMENTS -->

                          {user && (

                            <div
                              class="community-comments hidden mt-4 border-t border-white/10 pt-4"
                              data-post-id={post.id}
                            >

                              <div
                                class="space-y-3"
                              >

                                {post.comments.length >
                                0 ? (

                                  post.comments.map(
                                    (comment: any) => {

                                      const commentProfile =
                                        comment.profile;

                                      const commentName =
                                        commentProfile?.full_name ||
                                        commentProfile?.username ||
                                        "Melagram Member";

                                      const commentAvatar =
                                        commentProfile?.avatar_url;

                                      return (

                                        <div
                                          class="flex gap-3 rounded-xl border border-white/10 bg-black/20 p-3"
                                        >

                                          {commentAvatar ? (

                                            <img
                                              src={commentAvatar}
                                              alt={commentName}
                                              class="h-9 w-9 shrink-0 rounded-full border border-[#d9ad55]/30 object-cover"
                                            />

                                          ) : (

                                            <div
                                              class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#d9ad55]/30 bg-[#160722] text-xs font-semibold text-[#ffe8a6]"
                                            >
                                              {commentName
                                                .charAt(
                                                  0
                                                )
                                                .toUpperCase()}
                                            </div>

                                          )}

                                          <div
                                            class="min-w-0 flex-1"
                                          >

                                            <p
                                              class="text-xs font-semibold text-[#ffe8a6]"
                                            >
                                              {commentName}
                                            </p>

                                            <p
                                              class="mt-1 whitespace-pre-wrap text-xs leading-6 text-white/65"
                                            >
                                              {comment.content}
                                            </p>

                                          </div>

                                        </div>

                                      );

                                    }
                                  )

                                ) : (

                                  <p
                                    class="text-xs text-white/30"
                                  >
                                    No comments yet. Be the first.
                                  </p>

                                )}

                              </div>


                              <!-- COMMENT FORM -->

                              <form
                                class="community-comment-form mt-4 flex gap-2"
                                data-post-id={post.id}
                              >

                                <input
                                  type="text"
                                  name="content"
                                  maxlength="1000"
                                  required
                                  placeholder="Write a comment..."
                                  class="min-w-0 flex-1 rounded-full border border-white/10 bg-black/30 px-4 py-2.5 text-xs text-white outline-none placeholder:text-white/25 focus:border-[#d9ad55]/50"
                                />

                                <button
                                  type="submit"
                                  class="rounded-full bg-[#6d19c9] px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#7d27dc]"
                                >
                                  Post
                                </button>

                              </form>

                            </div>

                          )}

                        </article>

                      );

                    }
                  )}

                </div>

              )}

            </div>


            <!-- ABOUT COMMUNITY -->

            <aside
              class="luxury-panel gold-border rounded-2xl p-7"
            >

              <p
                class="text-[10px] font-bold uppercase tracking-[.4em] text-[#d9ad55]"
              >
                About
              </p>

              <h2
                class="display mt-3 text-2xl text-[#fff4d4]"
              >
                About this community
              </h2>

              <p
                class="mt-4 text-sm leading-7 text-white/45"
              >
                {community.description}
              </p>


              <div
                class="mt-7 border-t border-[#d9ad55]/20 pt-6"
              >

                <div
                  class="flex items-center justify-between"
                >

                  <span
                    class="text-[10px] uppercase tracking-wider text-white/30"
                  >
                    Members
                  </span>

                  <span
                    class="text-sm font-semibold text-[#ffe8a6]"
                  >
                    {community.members}
                  </span>

                </div>


                <div
                  class="mt-4 flex items-center justify-between"
                >

                  <span
                    class="text-[10px] uppercase tracking-wider text-white/30"
                  >
                    Category
                  </span>

                  <span
                    class="text-sm font-semibold text-[#ffe8a6]"
                  >
                    {community.category}
                  </span>

                </div>


                <div
                  class="mt-4 flex items-center justify-between"
                >

                  <span
                    class="text-[10px] uppercase tracking-wider text-white/30"
                  >
                    Posts
                  </span>

                  <span
                    class="text-sm font-semibold text-[#ffe8a6]"
                  >
                    {communityPosts.length}
                  </span>

                </div>

              </div>

            </aside>

          </div>

        </section>


        <!-- BACK TO COMMUNITIES -->

        <section
          class="px-5 py-16 text-center lg:px-10"
        >

          <a
            href="/communities"
            class="inline-flex rounded-xl border border-[#d9ad55]/60 px-7 py-3 text-xs font-bold uppercase tracking-wider text-[#ffe8a6] transition hover:bg-[#d9ad55] hover:text-black"
          >
            ← Browse Communities
          </a>

        </section>

      </main>


      <!-- FOOTER -->

      <footer
        class="border-t border-[#d9ad55]/20 bg-[#050208] px-5 py-10 lg:px-10"
      >

        <div
          class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 text-center sm:flex-row sm:text-left"
        >

          <div>

            <p
              class="display text-lg tracking-[.2em] text-[#ffe8a6]"
            >
              MELAGRAM
            </p>

            <p
              class="mt-1 text-[10px] uppercase tracking-[.3em] text-white/35"
            >
              Connect. Network. Create. Build Community.
            </p>

          </div>

          <p
            class="text-xs text-white/30"
          >
            © 2026 Melagram. All rights reserved.
          </p>

        </div>

      </footer>


      <!-- BOTTOM GOLD FRAME -->

      <div
        class="h-2 bg-gradient-to-r from-[#24102f] via-[#d9ad55] to-[#24102f]"
      ></div>

    </div>


    <!-- CLIENT INTERACTIONS -->

    <script>

      import { actions } from "astro:actions";


      /* --------------------------------
         JOIN / LEAVE COMMUNITY
      --------------------------------- */

      const joinButton =
        document.getElementById(
          "community-join-btn"
        ) as HTMLButtonElement | null;

      joinButton?.addEventListener(
        "click",
        async () => {

          const communityId =
            joinButton.dataset.communityId;

          if (!communityId) {
            alert(
              "We couldn't identify this community. Please refresh the page and try again."
            );
            return;
          }

          if (joinButton.disabled) {
            return;
          }

          const currentlyMember =
            joinButton.dataset.member ===
            "true";

          joinButton.disabled = true;
          joinButton.textContent =
            currentlyMember
              ? "Leaving..."
              : "Joining...";

          const result =
            currentlyMember
              ? await actions.leaveCommunity({
                  communityId,
                })
              : await actions.joinCommunity({
                  communityId,
                });

          const {
            data,
            error,
          } = result;

          if (
            error ||
            !data?.success
          ) {
            joinButton.disabled =
              false;

            joinButton.textContent =
              currentlyMember
                ? "Leave Community"
                : "Join Community";

            alert(
              data?.message ||
                "We couldn't update your community membership. Please try again."
            );
            return;
          }

          const joined =
            data.joined;

          joinButton.dataset.member =
            joined
              ? "true"
              : "false";

          joinButton.textContent =
            joined
              ? "Leave Community"
              : "Join Community";

          joinButton.disabled =
            false;

          joinButton.classList.toggle(
            "bg-[#6d19c9]",
            joined
          );
        }
      );


      /* --------------------------------
         NEW POST FOCUS
      --------------------------------- */

      const focusButton =
        document.getElementById(
          "community-post-focus"
        );

      focusButton?.addEventListener(
        "click",
        () => {

          const postContent =
            document.getElementById(
              "community-post-content"
            ) as HTMLTextAreaElement | null;

          postContent?.focus();

          postContent?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });

        }
      );


      /* --------------------------------
         CREATE COMMUNITY POST
      --------------------------------- */

      const communityPostForm =
        document.getElementById(
          "community-post-form"
        ) as HTMLFormElement | null;

      communityPostForm?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const contentInput =
            document.getElementById(
              "community-post-content"
            ) as HTMLTextAreaElement | null;

          const submitButton =
            document.getElementById(
              "community-post-submit"
            ) as HTMLButtonElement | null;

          const message =
            document.getElementById(
              "community-post-message"
            );

          if (
            !contentInput ||
            !submitButton
          ) {
            return;
          }

          const content =
            contentInput.value.trim();

          if (!content) {
            return;
          }

          submitButton.disabled =
            true;

          submitButton.textContent =
            "Publishing...";

          if (message) {
            message.classList.add(
              "hidden"
            );
          }

          const {
            data,
            error,
          } =
            await actions.createCommunityPost(
              {
                communitySlug:
                  "{slug}",
                content,
              }
            );

          if (
            error ||
            !data?.success
          ) {

            submitButton.disabled =
              false;

            submitButton.textContent =
              "Publish Post";

            if (message) {

              message.textContent =
                data?.message ||
                "We couldn't publish your post. Please try again.";

              message.classList.remove(
                "hidden"
              );

              message.classList.add(
                "text-red-300"
              );

            }

            return;
          }

          window.location.reload();

        }
      );


      /* --------------------------------
         LIKES
      --------------------------------- */

      const likeButtons =
        document.querySelectorAll<HTMLButtonElement>(
          ".community-like-btn"
        );

      likeButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            async () => {

              const postId =
                button.dataset.postId;

              if (!postId) {
                return;
              }

              if (button.disabled) {
                return;
              }

              button.disabled =
                true;

              const {
                data,
                error,
              } =
                await actions.toggleLike({
                  postId,
                });

              if (
                error ||
                !data?.success
              ) {

                button.disabled =
                  false;

                alert(
                  data?.message ||
                    "We couldn't update your like."
                );

                return;
              }

              const liked =
                data.liked;

              const icon =
                button.querySelector(
                  ".community-like-icon"
                );

              const label =
                button.querySelector(
                  ".community-like-label"
                );

              const count =
                button.querySelector(
                  ".community-like-count"
                );

              if (icon) {
                icon.textContent =
                  liked
                    ? "♥"
                    : "♡";
              }

              if (label) {
                label.textContent =
                  liked
                    ? "Liked"
                    : "Like";
              }

              if (count) {

                const current =
                  Number(
                    count.textContent ||
                      "0"
                  );

                count.textContent =
                  String(
                    liked
                      ? current + 1
                      : Math.max(
                          0,
                          current - 1
                        )
                  );
              }

              button.setAttribute(
                "aria-pressed",
                liked
                  ? "true"
                  : "false"
              );

              button.classList.toggle(
                "bg-[#6d19c9]/25",
                liked
              );

              button.classList.toggle(
                "text-[#ffe8a6]",
                liked
              );

              button.classList.toggle(
                "text-white/40",
                !liked
              );

              button.disabled =
                false;

            }
          );

        }
      );


      /* --------------------------------
         COMMENTS TOGGLE
      --------------------------------- */

      const commentButtons =
        document.querySelectorAll<HTMLButtonElement>(
          ".community-comment-toggle"
        );

      commentButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const postId =
                button.dataset.postId;

              if (!postId) {
                return;
              }

              const commentArea =
                document.querySelector<HTMLElement>(
                  `.community-comments[data-post-id="${postId}"]`
                );

              if (!commentArea) {
                return;
              }

              commentArea.classList.toggle(
                "hidden"
              );

              if (
                !commentArea.classList.contains(
                  "hidden"
                )
              ) {

                const input =
                  commentArea.querySelector<HTMLInputElement>(
                    'input[name="content"]'
                  );

                input?.focus();

              }

            }
          );

        }
      );


      /* --------------------------------
         CREATE COMMENT
      --------------------------------- */

      const commentForms =
        document.querySelectorAll<HTMLFormElement>(
          ".community-comment-form"
        );

      commentForms.forEach(
        (form) => {

          form.addEventListener(
            "submit",
            async (event) => {

              event.preventDefault();

              const postId =
                form.dataset.postId;

              const input =
                form.querySelector<HTMLInputElement>(
                  'input[name="content"]'
                );

              const submit =
                form.querySelector<HTMLButtonElement>(
                  "button[type='submit']"
                );

              if (
                !postId ||
                !input ||
                !submit
              ) {
                return;
              }

              const content =
                input.value.trim();

              if (!content) {
                return;
              }

              submit.disabled =
                true;

              submit.textContent =
                "Posting...";

              const {
                data,
                error,
              } =
                await actions.createComment({
                  postId,
                  content,
                });

              if (
                error ||
                !data?.success
              ) {

                submit.disabled =
                  false;

                submit.textContent =
                  "Post";

                alert(
                  data?.message ||
                    "We couldn't post your comment."
                );

                return;
              }

              window.location.reload();

            }
          );

        }
      );


      /* --------------------------------
         SHARE
      --------------------------------- */

      const shareButtons =
        document.querySelectorAll<HTMLButtonElement>(
          ".community-share-btn"
        );

      shareButtons.forEach(
        (button) => {

          button.addEventListener(
            "click",
            async () => {

              const postId =
                button.dataset.postId;

              if (!postId) {
                return;
              }

              const shareUrl =
                `${window.location.origin}/communities/{slug}#post-${postId}`;

              const label =
                button.querySelector(
                  ".community-share-label"
                );

              const icon =
                button.querySelector(
                  ".community-share-icon"
                );

              try {

                if (
                  navigator.share
                ) {

                  await navigator.share({
                    title:
                      "{community.name} — Melagram",
                    text:
                      "Check out this post on Melagram.",
                    url:
                      shareUrl,
                  });

                } else if (
                  navigator.clipboard
                ) {

                  await navigator.clipboard.writeText(
                    shareUrl
                  );

                } else {

                  const textarea =
                    document.createElement(
                      "textarea"
                    );

                  textarea.value =
                    shareUrl;

                  textarea.style.position =
                    "fixed";

                  textarea.style.opacity =
                    "0";

                  document.body.appendChild(
                    textarea
                  );

                  textarea.select();

                  document.execCommand(
                    "copy"
                  );

                  textarea.remove();

                }

                if (label) {
                  label.textContent =
                    "Copied!";
                }

                if (icon) {
                  icon.textContent =
                    "✓";
                }

                window.setTimeout(
                  () => {

                    if (label) {
                      label.textContent =
                        "Share";
                    }

                    if (icon) {
                      icon.textContent =
                        "↗";
                    }

                  },
                  1800
                );

              } catch {
                // User cancelled native share.
              }

            }
          );

        }
      );

    </script>

  </body>

</html>