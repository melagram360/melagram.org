    <!-- ===================================================== -->
    <!-- PROFILE INTERACTIONS -->
    <!-- ===================================================== -->

    <script>

      import { actions } from "astro:actions";


      /* --------------------------------
         FOLLOW / UNFOLLOW
      --------------------------------- */

      const followButton =
        document.getElementById(
          "followProfileButton"
        ) as HTMLButtonElement | null;

      followButton?.addEventListener(
        "click",
        async () => {

          const userId =
            followButton.dataset.userId;

          if (!userId) {
            return;
          }

          if (followButton.disabled) {
            return;
          }

          const currentlyFollowing =
            followButton.dataset.following ===
            "true";

          followButton.disabled =
            true;

          followButton.textContent =
            currentlyFollowing
              ? "Unfollowing..."
              : "Following...";

          const {
            data,
            error,
          } =
            await actions.toggleFollow({
              userId,
            });

          if (
            error ||
            !data?.success
          ) {

            followButton.disabled =
              false;

            followButton.textContent =
              currentlyFollowing
                ? "Following"
                : "Follow";

            alert(
              data?.message ||
                "We couldn't update your follow."
            );

            return;
          }

          const following =
            data.following;

          followButton.dataset.following =
            following
              ? "true"
              : "false";

          followButton.textContent =
            following
              ? "Following"
              : "Follow";

          followButton.classList.toggle(
            "cta",
            !following
          );

          followButton.classList.toggle(
            "border",
            following
          );

          followButton.classList.toggle(
            "border-[#d9ad55]/60",
            following
          );

          followButton.classList.toggle(
            "bg-[#24102f]",
            following
          );

          followButton.classList.toggle(
            "text-[#ffe8a6]",
            following
          );

          followButton.classList.toggle(
            "text-white",
            !following
          );

          const followerCount =
            document.getElementById(
              "followerCount"
            );

          if (followerCount) {

            const currentCount =
              Number(
                followerCount.textContent ||
                  "0"
              );

            followerCount.textContent =
              String(
                following
                  ? currentCount + 1
                  : Math.max(
                      0,
                      currentCount - 1
                    )
              );

          }

          followButton.disabled =
            false;

        }
      );


      /* --------------------------------
         SHARE PROFILE
      --------------------------------- */

      const shareButton =
        document.getElementById(
          "shareProfileButton"
        );

      shareButton?.addEventListener(
        "click",
        async () => {

          const shareData = {
            title:
              document.title,

            text:
              "Check out this Melagram profile.",

            url:
              window.location.href,
          };

          try {

            if (
              navigator.share
            ) {

              await navigator.share(
                shareData
              );

            } else if (
              navigator.clipboard
            ) {

              await navigator.clipboard.writeText(
                window.location.href
              );

              const originalText =
                shareButton.textContent;

              shareButton.textContent =
                "Profile Link Copied!";

              setTimeout(
                () => {

                  shareButton.textContent =
                    originalText;

                },
                2000
              );

            }

          } catch {

            console.log(
              "Share cancelled or unavailable."
            );

          }

        }
      );

    </script>

  </body>

</html>