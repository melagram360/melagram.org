---
import "../../../styles/global.css";
import { createClient } from "../../../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
  env: Astro.locals.runtime.env,
});

const requestedUsername = Astro.params.username;

let profile = null;
let members: any[] = [];
let errorMessage = "";

const {
  data: { user },
} = await supabase.auth.getUser();

if (requestedUsername) {
  const { data: profileData, error: profileError } =
    await supabase
      .from("profiles")
      .select("id, username, full_name, avatar_url")
      .eq("username", requestedUsername)
      .maybeSingle();

  if (profileError) {
    console.error("Follower profile error:", profileError);
    errorMessage = "We couldn't load this member.";
  }

  profile = profileData;
}

if (profile) {
  const {
    data: followRows,
    error: followsError,
  } = await supabase
    .from("follows")
    .select("follower_id, created_at")
    .eq("following_id", profile.id)
    .order("created_at", { ascending: false });

  if (followsError) {
    console.error("Followers query error:", followsError);
    errorMessage = "We couldn't load the followers.";
  }

  const followerIds =
    followRows?.map((row) => row.follower_id) ?? [];

  if (followerIds.length > 0) {
    const {
      data: followerProfiles,
      error: followerProfilesError,
    } = await supabase
      .from("profiles")
      .select("id, username, full_name, avatar_url")
      .in("id", followerIds);

    if (followerProfilesError) {
      console.error(
        "Follower profiles error:",
        followerProfilesError
      );

      errorMessage =
        "We couldn't load the follower profiles.";
    } else {
      const profileMap = new Map(
        (followerProfiles ?? []).map((member) => [
          member.id,
          member,
        ])
      );

      members = followerIds
        .map((id) => profileMap.get(id))
        .filter(Boolean);
    }
  }
}

const displayName =
  profile?.full_name ||
  profile?.username ||
  "Melagram Member";

const username =
  profile?.username ||
  requestedUsername ||
  "member";

const initials = displayName
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((name) => name[0])
  .join("")
  .toUpperCase();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      Followers of {displayName} | Melagram
    </title>

    <meta
      name="description"
      content={`See who follows ${displayName} on Melagram.`}
    />
  </head>

  <body class="min-h-screen bg-[#050208] text-[#fff7e5]">

    <!-- ===================================================== -->
    <!-- NAVIGATION -->
    <!-- ===================================================== -->

    <header
      class="border-b border-[#d9ad55]/30 bg-[#050208]/95"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4"
      >

        <a
          href="/"
          class="font-serif text-xl font-semibold tracking-[0.18em] text-[#ffe8a6]"
        >
          MELAGRAM
        </a>

        <nav class="hidden items-center gap-6 md:flex">

          <a
            href="/discover"
            class="nav-link text-sm text-[#fff7e5]/80"
          >
            Discover
          </a>

          <a
            href="/communities"
            class="nav-link text-sm text-[#fff7e5]/80"
          >
            Communities
          </a>

          <a
            href="/creators"
            class="nav-link text-sm text-[#fff7e5]/80"
          >
            Creators
          </a>

        </nav>

        <div class="flex items-center gap-2">

          {user ? (
            <>
              <a
                href="/profile"
                class="rounded-full border border-[#d9ad55]/50 px-4 py-2 text-sm text-[#ffe8a6] transition hover:bg-[#d9ad55]/10"
              >
                Profile
              </a>

              <a
                href="/dashboard"
                class="rounded-full bg-[#6d19c9] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#7d27dc]"
              >
                Dashboard
              </a>
            </>
          ) : (
            <a
              href="/login"
              class="rounded-full bg-[#6d19c9] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#7d27dc]"
            >
              Sign In
            </a>
          )}

        </div>

      </div>
    </header>


    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <main class="min-h-screen">

      <section
        class="mx-auto max-w-4xl px-5 py-12 sm:px-8 lg:py-16"
      >

        <!-- BACK TO PROFILE -->

        <a
          href={`/members/${username}`}
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-[#d9ad55] transition hover:text-[#ffe8a6]"
        >
          ← Back to Profile
        </a>


        <!-- ================================================= -->
        <!-- PROFILE HEADER -->
        <!-- ================================================= -->

        <div
          class="mt-8 overflow-hidden rounded-[2rem] border border-[#d9ad55]/60 bg-[#07030c] shadow-[0_0_50px_rgba(109,25,201,.16)]"
        >

          <div
            class="bg-[#180522] px-6 py-8 sm:px-8"
          >

            <div
              class="flex items-center gap-5"
            >

              <!-- AVATAR -->

              <div
                class="relative h-20 w-20 shrink-0 overflow-hidden rounded-full border-2 border-[#d9ad55]/70 bg-[#07030c]"
              >

                {profile?.avatar_url ? (
                  <img
                    src={profile.avatar_url}
                    alt={`${displayName} profile`}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div
                    class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_center,rgba(109,25,201,.55),rgba(7,3,12,.98)_70%)]"
                  >
                    <span
                      class="font-serif text-2xl font-semibold tracking-widest text-[#ffe8a6]"
                    >
                      {initials}
                    </span>
                  </div>
                )}

              </div>


              <!-- TITLE -->

              <div class="min-w-0">

                <p
                  class="text-[10px] font-bold uppercase tracking-[0.35em] text-[#d9ad55]"
                >
                  Connections
                </p>

                <h1
                  class="mt-2 truncate text-3xl font-semibold text-[#ffe8a6] sm:text-4xl"
                >
                  Followers
                </h1>

                <p
                  class="mt-2 text-sm text-white/45"
                >
                  People following {displayName}.
                </p>

              </div>

            </div>

          </div>


          <!-- ================================================= -->
          <!-- CONNECTION TABS -->
          <!-- ================================================= -->

          <div
            class="flex border-t border-[#d9ad55]/20"
          >

            <a
              href={`/members/${username}/followers`}
              class="flex-1 border-r border-[#d9ad55]/20 bg-[#6d19c9]/15 px-5 py-4 text-center text-xs font-bold uppercase tracking-[0.14em] text-[#ffe8a6]"
            >
              Followers
            </a>

            <a
              href={`/members/${username}/following`}
              class="flex-1 px-5 py-4 text-center text-xs font-bold uppercase tracking-[0.14em] text-white/45 transition hover:bg-[#6d19c9]/10 hover:text-[#ffe8a6]"
            >
              Following
            </a>

          </div>

        </div>


        <!-- ================================================= -->
        <!-- FOLLOWER LIST -->
        <!-- ================================================= -->

        <div class="mt-6">

          {errorMessage ? (

            <div
              class="rounded-2xl border border-red-400/20 bg-red-950/10 p-7"
            >

              <h2
                class="text-xl text-[#ffe8a6]"
              >
                Something went wrong.
              </h2>

              <p
                class="mt-3 text-sm leading-7 text-white/55"
              >
                {errorMessage}
              </p>

            </div>

          ) : !profile ? (

            <div
              class="gold-border luxury-panel rounded-2xl p-8 text-center"
            >

              <div class="gold-line mb-6"></div>

              <h2
                class="text-2xl text-[#ffe8a6]"
              >
                Member Not Found
              </h2>

              <p
                class="mt-3 text-sm leading-7 text-white/55"
              >
                We couldn't find a Melagram member with that username.
              </p>

              <a
                href="/discover"
                class="cta mt-6 inline-flex rounded-full px-6 py-3 text-sm font-semibold text-white"
              >
                Explore Members
              </a>

            </div>

          ) : members.length === 0 ? (

            <div
              class="gold-border luxury-panel rounded-2xl p-8 text-center"
            >

              <div class="gold-line mb-6"></div>

              <div
                class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-[#d9ad55]/40 bg-[#6d19c9]/15 text-2xl text-[#ffe8a6]"
              >
                ♡
              </div>

              <h2
                class="mt-6 text-2xl text-[#ffe8a6]"
              >
                No followers yet
              </h2>

              <p
                class="mt-3 text-sm leading-7 text-white/50"
              >
                When members follow {displayName}, they'll appear here.
              </p>

            </div>

          ) : (

            <div class="space-y-3">

              {members.map((member) => {

                const memberName =
                  member.full_name ||
                  member.username ||
                  "Melagram Member";

                const memberUsername =
                  member.username ||
                  "member";

                const memberInitials =
                  memberName
                    .split(" ")
                    .filter(Boolean)
                    .slice(0, 2)
                    .map((name: string) => name[0])
                    .join("")
                    .toUpperCase();

                return (

                  <article
                    class="gold-border luxury-panel rounded-2xl p-4 transition hover:border-[#d9ad55]/50 sm:p-5"
                  >

                    <div
                      class="flex items-center gap-4"
                    >

                      <!-- MEMBER AVATAR -->

                      <a
                        href={`/members/${memberUsername}`}
                        class="h-14 w-14 shrink-0 overflow-hidden rounded-full border border-[#d9ad55]/50 bg-[#07030c]"
                      >

                        {member.avatar_url ? (
                          <img
                            src={member.avatar_url}
                            alt={`${memberName} profile`}
                            class="h-full w-full object-cover"
                          />
                        ) : (
                          <div
                            class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_center,rgba(109,25,201,.55),rgba(7,3,12,.98)_70%)]"
                          >
                            <span
                              class="font-serif text-lg font-semibold text-[#ffe8a6]"
                            >
                              {memberInitials}
                            </span>
                          </div>
                        )}

                      </a>


                      <!-- MEMBER INFO -->

                      <div
                        class="min-w-0 flex-1"
                      >

                        <a
                          href={`/members/${memberUsername}`}
                          class="block truncate font-semibold text-[#ffe8a6] transition hover:text-white"
                        >
                          {memberName}
                        </a>

                        <a
                          href={`/members/${memberUsername}`}
                          class="mt-1 block truncate text-xs text-white/40 transition hover:text-[#d9ad55]"
                        >
                          @{memberUsername}
                        </a>

                      </div>


                      <!-- VIEW PROFILE -->

                      <a
                        href={`/members/${memberUsername}`}
                        class="shrink-0 rounded-full border border-[#d9ad55]/40 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#ffe8a6] transition hover:bg-[#6d19c9]/20"
                      >
                        View
                      </a>

                    </div>

                  </article>

                );

              })}

            </div>

          )}

        </div>

      </section>

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer
      class="border-t border-[#d9ad55]/20 bg-[#050208]"
    >

      <div
        class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-8 text-center text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between sm:text-left"
      >

        <p>
          © 2026 Melagram. Connect. Network. Create. Build Community.
        </p>

        <a
          href="/"
          class="text-[#d9ad55] transition hover:text-[#ffe8a6]"
        >
          Return Home
        </a>

      </div>

    </footer>

  </body>
</html>