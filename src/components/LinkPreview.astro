---
interface Props {
  linkUrl: string;
  linkType?: string | null;
  linkTitle?: string | null;
  linkDescription?: string | null;
  linkImageUrl?: string | null;
}

const {
  linkUrl,
  linkType,
  linkTitle,
  linkDescription,
  linkImageUrl,
} = Astro.props;

const platform =
  linkType === "youtube"
    ? "YouTube"
    : linkType === "tiktok"
      ? "TikTok"
      : linkType === "instagram"
        ? "Instagram"
        : "Website";

const platformIcon =
  linkType === "youtube"
    ? "▶"
    : linkType === "tiktok"
      ? "♪"
      : linkType === "instagram"
        ? "◎"
        : "🔗";

const title =
  linkTitle ||
  platform;

const description =
  linkDescription ||
  "Open this link on the web.";

const getYouTubeVideoId = (url: string): string | null => {
  try {
    const parsed = new URL(url);
    const hostname = parsed.hostname
      .toLowerCase()
      .replace(/^www\./, "");

    if (
      hostname === "youtube.com" ||
      hostname === "m.youtube.com"
    ) {
      if (parsed.pathname === "/watch") {
        return parsed.searchParams.get("v");
      }

      if (parsed.pathname.startsWith("/shorts/")) {
        return (
          parsed.pathname
            .split("/")[2]
            ?.split("?")[0] || null
        );
      }

      if (parsed.pathname.startsWith("/embed/")) {
        return (
          parsed.pathname
            .split("/")[2]
            ?.split("?")[0] || null
        );
      }

      if (parsed.pathname.startsWith("/live/")) {
        return (
          parsed.pathname
            .split("/")[2]
            ?.split("?")[0] || null
        );
      }
    }

    if (hostname === "youtu.be") {
      return (
        parsed.pathname
          .split("/")[1]
          ?.split("?")[0] || null
      );
    }

    return null;
  } catch {
    return null;
  }
};

const youtubeVideoId =
  linkType === "youtube"
    ? getYouTubeVideoId(linkUrl)
    : null;

const isYouTubeVideo =
  Boolean(youtubeVideoId);
---

{
  isYouTubeVideo && youtubeVideoId ? (
    <div class="group mt-5 overflow-hidden rounded-2xl border border-[#d9ad55]/30 bg-black/40">
      <div class="relative aspect-video w-full overflow-hidden bg-black">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}?rel=0`}
          title={title}
          class="absolute inset-0 h-full w-full"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <div class="border-t border-[#d9ad55]/20 p-5">
        <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#d9ad55]">
          <span>{platformIcon}</span>
          <span>{platform}</span>
        </div>

        <h3 class="mt-2 text-lg font-semibold text-[#ffe8a6]">
          {title}
        </h3>

        {description && (
          <p class="mt-2 text-sm leading-6 text-white/50">
            {description}
          </p>
        )}

        <a
          href={linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-white/60 transition hover:text-[#ffe8a6]"
        >
          Open on {platform}
          <span>↗</span>
        </a>
      </div>
    </div>
  ) : (
    <a
      href={linkUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-5 block overflow-hidden rounded-2xl border border-[#d9ad55]/30 bg-black/40 transition duration-300 hover:border-[#d9ad55]/70 hover:bg-black/60"
    >
      {linkImageUrl && (
        <div class="relative overflow-hidden bg-black">
          <img
            src={linkImageUrl}
            alt={title}
            class="aspect-video w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      )}

      <div class="p-5">
        <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#d9ad55]">
          <span>{platformIcon}</span>
          <span>{platform}</span>
        </div>

        <h3 class="mt-2 text-lg font-semibold text-[#ffe8a6]">
          {title}
        </h3>

        {description && (
          <p class="mt-2 text-sm leading-6 text-white/50">
            {description}
          </p>
        )}

        <div class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-white/60 transition group-hover:text-[#ffe8a6]">
          Open on {platform}
          <span>↗</span>
        </div>
      </div>
    </a>
  )
}
