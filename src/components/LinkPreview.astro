---
interface Props {
  linkUrl: string;
  linkType?: string | null;
  linkTitle?: string | null;
  linkDescription?: string | null;
  linkImageUrl?: string | null;
}

const {
  linkUrl,
  linkType,
  linkTitle,
  linkDescription,
  linkImageUrl,
} = Astro.props;

const getHostname = (url: string): string => {
  try {
    return new URL(url).hostname
      .toLowerCase()
      .replace(/^www\./, "");
  } catch {
    return "";
  }
};

const hostname = getHostname(linkUrl);

const platform =
  linkType === "youtube" ||
  hostname === "youtube.com" ||
  hostname === "m.youtube.com" ||
  hostname === "youtu.be"
    ? "YouTube"
    : linkType === "tiktok" ||
        hostname === "tiktok.com" ||
        hostname === "m.tiktok.com"
      ? "TikTok"
      : linkType === "instagram" ||
          hostname === "instagram.com"
        ? "Instagram"
        : hostname === "facebook.com" ||
            hostname === "m.facebook.com" ||
            hostname === "fb.watch"
          ? "Facebook"
          : "Website";

const platformIcon =
  platform === "YouTube"
    ? "▶"
    : platform === "TikTok"
      ? "♪"
      : platform === "Instagram"
        ? "◎"
        : platform === "Facebook"
          ? "f"
          : "🔗";

const title =
  linkTitle ||
  platform;

const description =
  linkDescription ||
  "Open this link on the web.";

const getYouTubeVideoId = (url: string): string | null => {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname
      .toLowerCase()
      .replace(/^www\./, "");

    if (
      host === "youtube.com" ||
      host === "m.youtube.com"
    ) {
      if (parsed.pathname === "/watch") {
        return parsed.searchParams.get("v");
      }

      if (parsed.pathname.startsWith("/shorts/")) {
        return (
          parsed.pathname
            .split("/")[2]
            ?.split("?")[0] || null
        );
      }

      if (parsed.pathname.startsWith("/embed/")) {
        return (
          parsed.pathname
            .split("/")[2]
            ?.split("?")[0] || null
        );
      }

      if (parsed.pathname.startsWith("/live/")) {
        return (
          parsed.pathname
            .split("/")[2]
            ?.split("?")[0] || null
        );
      }
    }

    if (host === "youtu.be") {
      return (
        parsed.pathname
          .split("/")[1]
          ?.split("?")[0] || null
      );
    }

    return null;
  } catch {
    return null;
  }
};

const getTikTokVideoId = (url: string): string | null => {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname
      .toLowerCase()
      .replace(/^www\./, "");

    if (
      host !== "tiktok.com" &&
      host !== "m.tiktok.com"
    ) {
      return null;
    }

    const match =
      parsed.pathname.match(
        /\/video\/(\d+)/
      );

    return match?.[1] || null;
  } catch {
    return null;
  }
};

const getInstagramEmbedUrl = (
  url: string
): string | null => {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname
      .toLowerCase()
      .replace(/^www\./, "");

    if (host !== "instagram.com") {
      return null;
    }

    const match =
      parsed.pathname.match(
        /^\/(?:reel|reels|p|tv)\/([^/?#]+)/
      );

    if (!match?.[1]) {
      return null;
    }

    const type =
      parsed.pathname
        .split("/")
        .filter(Boolean)[0];

    if (!type) {
      return null;
    }

    return `https://www.instagram.com/${type}/${match[1]}/embed`;
  } catch {
    return null;
  }
};

const isFacebookVideo =
  platform === "Facebook" &&
  (
    hostname === "facebook.com" ||
    hostname === "m.facebook.com" ||
    hostname === "fb.watch"
  );

const youtubeVideoId =
  getYouTubeVideoId(linkUrl);

const tiktokVideoId =
  getTikTokVideoId(linkUrl);

const instagramEmbedUrl =
  getInstagramEmbedUrl(linkUrl);

const isYouTubeVideo =
  Boolean(youtubeVideoId);

const isTikTokVideo =
  Boolean(tiktokVideoId);

const isInstagramVideo =
  Boolean(instagramEmbedUrl);

const facebookEmbedUrl =
  isFacebookVideo
    ? `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(linkUrl)}&show_text=false&width=800`
    : null;

const isEmbeddedVideo =
  isYouTubeVideo ||
  isTikTokVideo ||
  isInstagramVideo ||
  Boolean(facebookEmbedUrl);
---

{
  isEmbeddedVideo ? (
    <div class="group mt-5 overflow-hidden rounded-2xl border border-[#d9ad55]/30 bg-black/40">
      <div class="relative aspect-video w-full overflow-hidden bg-black">

        {isYouTubeVideo && youtubeVideoId ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}?rel=0`}
            title={title}
            class="absolute inset-0 h-full w-full"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        ) : isTikTokVideo && tiktokVideoId ? (
          <iframe
            src={`https://www.tiktok.com/player/v1/${tiktokVideoId}?description=1&music_info=1&rel=0`}
            title={title}
            class="absolute inset-0 h-full w-full"
            loading="lazy"
            allow="fullscreen"
            allowfullscreen
          ></iframe>
        ) : isInstagramVideo && instagramEmbedUrl ? (
          <iframe
            src={instagramEmbedUrl}
            title={title}
            class="absolute inset-0 h-full w-full"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        ) : facebookEmbedUrl ? (
          <iframe
            src={facebookEmbedUrl}
            title={title}
            class="absolute inset-0 h-full w-full"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        ) : null}

      </div>

      <div class="border-t border-[#d9ad55]/20 p-5">
        <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#d9ad55]">
          <span>{platformIcon}</span>
          <span>{platform}</span>
        </div>

        <h3 class="mt-2 text-lg font-semibold text-[#ffe8a6]">
          {title}
        </h3>

        {description && (
          <p class="mt-2 text-sm leading-6 text-white/50">
            {description}
          </p>
        )}

        <a
          href={linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-white/60 transition hover:text-[#ffe8a6]"
        >
          Open on {platform}
          <span>↗</span>
        </a>
      </div>
    </div>
  ) : (
    <a
      href={linkUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-5 block overflow-hidden rounded-2xl border border-[#d9ad55]/30 bg-black/40 transition duration-300 hover:border-[#d9ad55]/70 hover:bg-black/60"
    >
      {linkImageUrl && (
        <div class="relative overflow-hidden bg-black">
          <img
            src={linkImageUrl}
            alt={title}
            class="aspect-video w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      )}

      <div class="p-5">
        <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#d9ad55]">
          <span>{platformIcon}</span>
          <span>{platform}</span>
        </div>

        <h3 class="mt-2 text-lg font-semibold text-[#ffe8a6]">
          {title}
        </h3>

        {description && (
          <p class="mt-2 text-sm leading-6 text-white/50">
            {description}
          </p>
        )}

        <div class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-white/60 transition group-hover:text-[#ffe8a6]">
          Open on {platform}
          <span>↗</span>
        </div>
      </div>
    </a>
  )
}
